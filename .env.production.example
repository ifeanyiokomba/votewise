# VoteWise — .env.production.example
# Copy to .env.production and fill in real values.
# NEVER commit the real .env.production file.

# === DATABASE ===
DATABASE_URL="postgresql://votewise:CHANGE_ME@localhost:5432/votewise"
DATABASE_REPLICA_URL="postgresql://votewise:CHANGE_ME@replica.internal:5432/votewise"
DB_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# === REDIS ===
REDIS_URL="redis://localhost:6379"

# === SECRETS (generate with: openssl rand -hex 32) ===
VOTE_ENC_KEY=""
VOTER_HASH_PEPPER=""
HMAC_SECRET=""
SVE_BALLOT_PEPPER=""
SVE_VOTER_PEPPER=""
VOTE_KEY_ID="v1"

# === PAYMENT GATEWAYS ===
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""

# === NOTIFICATION PROVIDERS ===
RESEND_API_KEY=""
TERMII_API_KEY=""
TERMII_SENDER_ID="VoteWise"

# === OAUTH (for integrations) ===
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# === MONITORING ===
SENTRY_DSN=""
LOG_LEVEL="info"
SLACK_WEBHOOK_URL=""
TEAMS_WEBHOOK_URL=""

# === STORAGE ===
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# === DOMAIN ===
NEXT_PUBLIC_APP_URL="https://votewise.com.ng"
NEXT_PUBLIC_API_URL="https://votewise.com.ng/api"
