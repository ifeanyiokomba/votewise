# .env.staging.example — Staging environment
# Copy to .env.staging and fill with STAGING values (never production data).
# Staging exists to catch bugs before they reach production.

# === DATABASE (staging RDS) ===
DATABASE_URL="postgresql://votewise:CHANGE_ME@staging-db.internal:5432/votewise"
DB_PASSWORD="CHANGE_ME_STAGING"

# === REDIS (staging ElastiCache) ===
REDIS_URL="redis://staging-redis.internal:6379"

# === SECRETS (generate with: openssl rand -hex 32) — MUST differ from production ===
VOTE_ENC_KEY=""
VOTER_HASH_PEPPER=""
HMAC_SECRET=""
SVE_BALLOT_PEPPER=""
SVE_VOTER_PEPPER=""
VOTE_KEY_ID="v1"

# === PAYMENT (sandbox/test keys only) ===
PAYSTACK_SECRET_KEY="sk_test_"
PAYSTACK_PUBLIC_KEY="pk_test_"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-"

# === NOTIFICATION (test providers) ===
RESEND_API_KEY="re_test_"
TERMII_API_KEY=""
TERMII_SENDER_ID="VoteWise"

# === MONITORING ===
SENTRY_DSN=""
LOG_LEVEL="debug"

# === STORAGE (staging bucket) ===
S3_BUCKET="votewise-staging-storage"
S3_REGION="eu-west-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# === DOMAIN ===
NEXT_PUBLIC_APP_URL="https://staging.votewise.com.ng"
NEXT_PUBLIC_API_URL="https://staging.votewise.com.ng/api"
