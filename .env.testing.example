# .env.testing.example — CI / automated test environment
# Used by GitHub Actions. All values are synthetic. NEVER real secrets.

DATABASE_URL="file:./db/test.db"
REDIS_URL=""
S3_BUCKET=""

# Synthetic test secrets (safe to commit; not used in production)
VOTE_ENC_KEY="test-key-32bytes-minimum-padding!!"
VOTER_HASH_PEPPER="test-pepper"
HMAC_SECRET="test-hmac-secret"
SVE_BALLOT_PEPPER="test-ballot-pepper"
SVE_VOTER_PEPPER="test-voter-pepper"
VOTE_KEY_ID="v1"

# Providers are NOT configured in test env (graceful fallback expected)
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""
RESEND_API_KEY=""
TERMII_API_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
LOG_LEVEL="error"
NODE_ENV="test"
