// VoteWise — Africa's most trusted Election Management Platform.
// Generic multi-tenant schema: Organization → Workspace → Election → Voter Groups
//                                  → Voters → Candidates → Voting → Results
// Works for ANY organization (universities, companies, churches, NGOs, clubs, etc.)
// SQLite in sandbox; swap `provider` to `postgresql` + `DATABASE_URL` for production.
//
// CHAPTER 1 NOTE: The legacy `Tenant` / `Faculty` / `Department` / `Programme` /
// `Level` / `StudentCollation` models below are RETAINED for backwards
// compatibility with the existing seeded demo election. They are DEPRECATED and
// will be removed in a later chapter once the new `Organization` hierarchy fully
// replaces them. All NEW features must use the generic `Organization` hierarchy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// CHAPTER 1 — GENERIC ORGANIZATION HIERARCHY (NEW)
// Organization → Workspace → Election → Voter Groups → Voters → Candidates
// ===========================================================================

/// An Organization is any entity that runs elections on VoteWise.
/// Universities, polytechnics, colleges, student unions, churches, mosques,
/// NGOs, political parties, government agencies, companies, cooperatives,
/// professional bodies, communities, clubs, associations, trade unions,
/// market associations, resident associations, sports clubs — ALL are simply
/// Organizations. The system never knows or cares which one it is.
model Organization {
  id              String   @id @default(cuid())
  name            String   // "University of Lagos" / "MTN Nigeria" / "Red Cross Nigeria"
  slug            String   @unique
  subdomain       String?  @unique // e.g. "unilag" → unilag.votewise.ng
  customDomain    String?  @unique // e.g. "vote.unilag.edu.ng" (Chapter 3 spec field)
  organizationType String? // Chapter 3 spec field (alias for category)
  // Branding
  logoUrl         String?
  darkModeLogoUrl String?
  primaryColour   String   @default("#15803d")
  secondaryColour String?  // optional secondary brand colour
  accentColour    String   @default("#b45309")
  // Owner (the person who registered — Organization Owner role)
  ownerEmail      String
  ownerName       String
  ownerPhone      String?
  createdBy       String?  // Chapter 3: who created this org (userId)
  // Location + locale
  country         String?  // e.g. "Nigeria"
  state           String?  // e.g. "Lagos"
  timezone        String   @default("Africa/Lagos")
  language        String   @default("en")
  // Lifecycle & billing
  status          String   @default("TRIAL") // TRIAL | ACTIVE | SUSPENDED | EXPIRED | ARCHIVED
  plan            String   @default("PAYG")  // FREE | PAYG | ENTERPRISE
  voterQuota      Int      @default(0)       // voters paid for
  paidUntil       DateTime?
  // Optional categorization (purely informational — never gates features)
  category        String?  // UNIVERSITY | POLYTECHNIC | COLLEGE | STUDENT_UNION | CHURCH | MOSQUE | NGO | POLITICAL_PARTY | GOVERNMENT | COMPANY | COOPERATIVE | PROFESSIONAL_BODY | COMMUNITY | CLUB | ASSOCIATION | TRADE_UNION | MARKET_ASSOCIATION | RESIDENT_ASSOCIATION | SPORTS_CLUB | OTHER
  // Free-form descriptor the org sets for itself
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspaces      Workspace[]
  voterGroups     VoterGroup[]
  members         OrganizationMember[]
  terminology     OrganizationTerminology?
  elections       ElectionSession[]
  domains         OrganizationDomain[]
  subscription    OrganizationSubscription?
  settings        OrganizationWorkspaceSetting?
}

/// Custom domain connection — one org can have multiple domains (primary + aliases).
/// DNS verification is checked on connection. On subscription expiry, the domain
/// is disconnected (status → DISCONNECTED) but NOT deleted — reconnection on renewal.
model OrganizationDomain {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domain          String   @unique // e.g. "vote.myorg.org"
  isPrimary       Boolean  @default(true)
  status          String   @default("PENDING") // PENDING (DNS not verified) | VERIFIED | DISCONNECTED
  dnsVerifiedAt   DateTime?
  connectedAt     DateTime @default(now())
  disconnectedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

/// Subscription state — separated from Organization for clean billing management.
model OrganizationSubscription {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan            String   @default("PAYG") // FREE | PAYG | ENTERPRISE
  status          String   @default("TRIAL") // TRIAL | ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  voterQuota      Int      @default(0)
  votersUsed      Int      @default(0)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt     DateTime?
  // Paystack
  paystackCustomerCode String?
  paystackSubscriptionCode String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Workspace-level settings (OTP prefs, notification channels, election defaults).
model OrganizationWorkspaceSetting {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // OTP preferences
  defaultOtpChannel String  @default("EMAIL") // EMAIL | SMS | WHATSAPP
  defaultOtpTtlSeconds Int  @default(600)
  defaultMaxOtpAttempts Int @default(5)
  // Notification channels
  notifyEmail     Boolean  @default(true)
  notifySms       Boolean  @default(false)
  notifyWhatsapp  Boolean  @default(false)
  // Election defaults
  defaultRequireAccreditation Boolean @default(true)
  defaultBallotRandomization  Boolean @default(true)
  defaultNotaEnabled          Boolean @default(true)
  defaultPublicLiveResults    Boolean @default(true)
  // Security
  require2faForAdmins Boolean @default(true)
  singleDeviceEnforcement Boolean @default(false)
  updatedAt       DateTime @updatedAt
}

/// Organization Unit (formerly "Workspace") — the hierarchical election
/// division within an Organization. Can represent:
///   University: Faculty / Department / School / Hall
///   Company: Region / Branch / Division
///   Church: Diocese / Parish / Fellowship
///   Government: State / LGA / Zone
///   Market: Section / Line
///   Association: Chapter / Branch
///
/// Each unit owns elections, can have its own observers/admins, and runs
/// independently. Units can be nested (parentWorkspaceId) for arbitrary depth
/// (e.g. Faculty → Department → Programme).
///
/// This is the core architectural capability that lets a university run
/// hundreds of concurrent faculty/department elections, each with its own
/// dashboard, observers, and results — all under one organization.
model Workspace {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentWorkspaceId String? // nested units (e.g. Department under Faculty)
  parent          Workspace?  @relation("WorkspaceHierarchy", fields: [parentWorkspaceId], references: [id], onDelete: SetNull)
  children        Workspace[] @relation("WorkspaceHierarchy")
  name            String   // "Faculty of Engineering" / "Lagos Region" / "Youth Church"
  slug            String
  unitType        String?  // Chapter 5: "Faculty" | "Department" | "Branch" | "Region" | "Parish" | "Chapter" | "Zone" | "Committee" | "Market Section" | "District" — org-defined
  code            String?  // "ENG" / "LOS" / "YTH"
  description     String?
  metadata        String?  // JSON for flexible extra attributes
  // Unit-level admin (who manages this unit's elections)
  unitAdminId     String?  // OrganizationMember ID of the unit admin
  createdBy       String?  // Chapter 5: who created this unit (userId)
  // Unit status
  status          String   @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  voterGroups     VoterGroup[]
  elections       ElectionSession[]
  observerAssignments UnitObserverAssignment[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([parentWorkspaceId])
  @@index([status])
}

/// Unit Observer Assignment — observers are assigned to specific Organization
/// Units, NOT the whole organization. This enables scoped monitoring:
///   Mr. John → Faculty of Engineering → Observer
///   Mrs. Grace → Faculty of Law → Observer
/// Platform Super Admin + Org Owner can monitor all units.
model UnitObserverAssignment {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String   // the Organization Unit this observer is assigned to
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberId        String?  // OrganizationMember ID (the observer)
  memberEmail     String   // email (for invitation tracking)
  memberName      String
  status          String   @default("ACTIVE") // ACTIVE | REVOKED
  assignedAt      DateTime @default(now())
  revokedAt       DateTime?
  createdAt       DateTime @default(now())

  @@unique([workspaceId, memberEmail])
  @@index([workspaceId])
  @@index([organizationId])
}

/// A Voter Group is a flexible grouping of voters within an Organization.
/// This replaces the hardcoded Faculty/Department scoping. An org can define
/// arbitrary voter groups: "300-Level Engineering", "Lagos Members", "Board
/// Members", "Paid-up Members 2024", etc. Elections/positions can be scoped
/// to one or more voter groups.
model VoterGroup {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId     String?  // optional workspace this group belongs to
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  name            String   // "300-Level Computer Science" / "Lagos Branch Members"
  slug            String
  code            String?  // "CSC300" / "LOS"
  description     String?
  metadata        String?  // JSON: { level: "300", branch: "Lagos", ... }
  voterCount      Int      @default(0) // cached count for billing/display
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([workspaceId])
}

/// Organization Member — the six user roles (Chapter 1 product vision).
/// PLATFORM_SUPER_ADMIN | ORG_OWNER | ORG_ADMIN | OBSERVER | VOTER | GUEST
/// GUEST is implicit (not logged in) and rarely stored; included for completeness.
/// This model is the NEW RBAC identity. The legacy `ElectionOfficial` model
/// is retained for the seeded demo and will be migrated in a later chapter.
/// Chapter 4: OrganizationMember is now the unified User model. A single user
/// (identified by email) can belong to MULTIPLE organizations with different
/// roles — the same email can exist in multiple orgs. The @@unique constraint
/// is [organizationId, email] (not global email @unique).
/// The legacy `ElectionOfficial` table is retained for the demo election only.
model OrganizationMember {
  id              String   @id @default(cuid())
  organizationId  String?  // null for PLATFORM_SUPER_ADMIN (platform-wide)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email           String   // Chapter 4: NOT globally unique — same email can join multiple orgs
  name            String
  role            String   // PLATFORM_SUPER_ADMIN | ORG_OWNER | ORG_ADMIN | OBSERVER | VOTER | GUEST
  passwordHash    String
  // Chapter 4: account status (ACTIVE | PENDING | SUSPENDED | LOCKED | DISABLED | ARCHIVED)
  accountStatus   String   @default("ACTIVE")
  // 2FA (required for PLATFORM_SUPER_ADMIN and ORG_OWNER per RBAC policy)
  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  backupCodes     String?  // JSON array of hashed codes
  // Email verification + password reset + lockout
  emailVerified   Boolean  @default(false)
  emailVerifyToken String?
  passwordResetToken String?
  passwordResetExpiresAt DateTime?
  failedAttempts  Int      @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  // Profile
  phone           String?
  avatarUrl       String?
  title           String?  // "Electoral Chairman" / "Returning Officer"
  metadata        String?  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  roles           OrganizationMemberRole[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([role])
  @@index([email])
  @@index([accountStatus])
}

/// OrganizationMemberRole — links members to roles (many-to-many). A member
/// can have multiple roles within an organization.
model OrganizationMemberRole {
  id              String   @id @default(cuid())
  memberId        String
  member          OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleId          String
  role            Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([memberId, roleId])
  @@index([memberId])
  @@index([roleId])
}

/// Organization Terminology — Principle 4: Everything configurable.
/// Organizations configure their own terminology instead of VoteWise hardcoding
/// "University", "Faculty", "Department", "Church", "Market", "Company".
/// Each label has a sensible default; orgs override per their domain.
model OrganizationTerminology {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationLabel String @default("Organization")  // "University" / "Company" / "Church"
  workspaceLabel  String   @default("Workspace")      // "Faculty" / "Branch" / "Parish"
  voterGroupLabel String   @default("Voter Group")    // "Department" / "Unit" / "Cell"
  voterLabel      String   @default("Voter")          // "Student" / "Member" / "Employee"
  candidateLabel  String   @default("Candidate")      // "Aspirant" / "Nominee"
  electionLabel   String   @default("Election")       // "Poll" / "Vote"
  positionLabel   String   @default("Position")       // "Office" / "Role"
  ballotLabel     String   @default("Ballot")
  receiptLabel    String   @default("Receipt")
  officialLabel   String   @default("Electoral Officer") // "Returning Officer" / "Committee Member"
  observerLabel   String   @default("Observer")
  updatedAt       DateTime @updatedAt
}

// ===========================================================================
// LEGACY MODELS (DEPRECATED — Chapter 1 retention)
// The following Tenant/Faculty/Department/Programme/Level/StudentCollation
// models are university-specific and will be removed once the new
// Organization/Workspace/VoterGroup hierarchy fully replaces them.
// All NEW features MUST use the generic hierarchy above.
// ===========================================================================

// ===========================================================================
// CHAPTER 3 — DATABASE REFACTORING & DOMAIN MODEL (NEW)
// Generic, enterprise-grade models. No university assumptions. Dynamic voter
// fields, normalized RBAC, separated domains (voting/billing/branding/support).
// Every table references organizationId (except platform-level config).
// ===========================================================================

/// Role — stored, not hardcoded. Each organization can have custom roles,
/// but defaults (Owner, Admin, Observer, Support, Auditor, Voter) are seeded.
model Role {
  id              String   @id @default(cuid())
  organizationId  String?  // null = platform-wide default role
  name            String   // "Owner" | "Admin" | "Observer" | "Support" | "Auditor" | "Voter" | custom
  description     String?
  isSystem        Boolean  @default(false) // true for the 6 default roles (cannot be deleted)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members         OrganizationMemberRole[]
  permissions     RolePermission[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Permission — stored separately. Enterprise-ready: permissions are granular
/// and linkable to any role via RolePermission.
model Permission {
  id              String   @id @default(cuid())
  key             String   @unique // "election.create" | "voter.import" | "billing.manage" | ...
  description     String?
  category        String   // "election" | "voter" | "billing" | "security" | "audit" | ...
  createdAt       DateTime @default(now())

  roles           RolePermission[]
}

/// RolePermission — links roles to permissions (many-to-many).
model RolePermission {
  id              String   @id @default(cuid())
  roleId          String
  role            Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId    String
  permission      Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

/// VoterField — dynamic voter fields per organization. Organizations define
/// what voter info they require (matric number / employee ID / membership
/// number / parish / shop number / etc.). The voter importer builds itself
/// dynamically from these definitions.
model VoterField {
  id              String   @id @default(cuid())
  organizationId  String
  label           String   // "Matric Number" | "Employee ID" | "Membership Number"
  key             String   // "matricNumber" | "employeeId" | "membershipNumber"
  fieldType       String   // TEXT | NUMBER | EMAIL | PHONE | SELECT | DATE
  required        Boolean  @default(false)
  displayOrder    Int      @default(0)
  options         String?  // JSON array for SELECT type
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

/// ImportJob — async CSV import tracking. Imports never happen synchronously.
/// A background worker processes the import; the UI polls for status.
model ImportJob {
  id              String   @id @default(cuid())
  organizationId  String
  uploadedById    String?
  status          String   @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  fileName        String?
  totalRows       Int      @default(0)
  processedRows   Int      @default(0)
  failedRows      Int      @default(0)
  completedRows   Int      @default(0)
  errors          String?  // JSON array of row-level errors
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

/// VotingCredential — separated OTVP (One-Time Voting Password). Supports
/// Email/SMS/WhatsApp without changing the schema. Separate from Voter so
/// credential delivery can be retried/audited independently.
model VotingCredential {
  id              String   @id @default(cuid())
  organizationId  String
  voterId         String
  electionId      String?
  deliveryMethod  String   // EMAIL | SMS | WHATSAPP
  code            String   // the OTVP code (hashed in production)
  destination     String?  // masked email/phone
  expiresAt       DateTime
  attempts        Int      @default(0)
  status          String   @default("PENDING") // PENDING | VERIFIED | EXPIRED | USED
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([voterId])
  @@index([status])
}

/// VotingSession — tracks whether a voter has voted (separate from the Vote
/// itself). This separation improves ballot secrecy: the vote record has no
/// voter identity, only the encryptedReceipt.
model VotingSession {
  id              String   @id @default(cuid())
  organizationId  String
  electionId      String?
  voterId         String
  sessionToken    String   @unique
  accredited      Boolean  @default(false)
  accreditedAt    DateTime?
  hasVoted        Boolean  @default(false)
  votedAt         DateTime?
  deviceFingerprint String?
  ipAddress       String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([voterId])
  @@index([electionId])
}

/// SupportMessage — messages within a support ticket. Supports voter →
/// observer → platform escalation.
model SupportMessage {
  id              String   @id @default(cuid())
  ticketId        String
  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId        String?
  senderName      String
  senderRole      String   // VOTER | OBSERVER | ADMIN | SUPPORT | SYSTEM
  message         String
  attachments     String?  // JSON array of {type, name, dataUrl}
  readAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

/// OrganizationBrand — white-label branding. Everything visual lives here,
/// separate from the Organization core record.
model OrganizationBrand {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  logo            String?
  darkModeLogo    String?
  favicon         String?
  primaryColor    String   @default("#15803d")
  secondaryColor  String?
  accentColor     String   @default("#b45309")
  font            String?  // "Inter" | "Geist" | custom
  customCSS       String?
  loginBackground String?
  updatedAt       DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Multi-tenant: Organizations (University / Faculty / Department) — LEGACY
// ---------------------------------------------------------------------------
model Tenant {
  id              String   @id @default(cuid())
  // Organization type
  type            String   // UNIVERSITY | FACULTY | DEPARTMENT
  // Institution type (supports ALL tertiary institutions, not just federal)
  institutionType String?  // FEDERAL | STATE | PRIVATE | POLYTECHNIC | COLLEGE_OF_EDUCATION | MONOTECHNIC
  // Names — filled based on type
  universityName  String
  facultyName     String?
  departmentName  String?
  // Display name (auto-generated or custom)
  displayName     String
  slug            String   @unique
  // Branding
  logoUrl         String?
  universityLogoUrl String?
  primaryColour   String   @default("#15803d")
  accentColour    String   @default("#b45309")
  // Subdomain (auto-assigned on signup: e.g. unilag.votewise.ng)
  subdomain       String?  @unique
  // Admin who created this tenant
  adminEmail      String
  // Status
  status          String   @default("ACTIVE") // ACTIVE | SUSPENDED | TRIAL
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  electionSessions ElectionSession[]
  faculties        Faculty[]
  departments      Department[]
  officials        ElectionOfficial[]
  voters           Voter[]
  settings         ElectionSetting[]
  collations       StudentCollation[]
}

// ---------------------------------------------------------------------------
// Student data collation — dept collects → faculty reviews → committee uploads
// ---------------------------------------------------------------------------
model StudentCollation {
  id              String   @id @default(cuid())
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Source
  facultyId       String?
  faculty         Faculty? @relation(fields: [facultyId], references: [id])
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  // Who submitted
  submittedById   String?
  submittedByName String
  submittedByRole String   // DEPARTMENT_OFFICER | FACULTY_OFFICER | ELECTORAL_COMMITTEE
  // Data
  studentCount    Int      @default(0)
  rawData         String?  // JSON array of student records
  // Approval workflow
  status          String   @default("PENDING") // PENDING | FACULTY_APPROVED | COMMITTEE_APPROVED | REJECTED | UPLOADED
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNotes     String?
  // When approved by committee, voters are imported
  importedAt      DateTime?
  importedCount   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Election configuration
// ---------------------------------------------------------------------------
model ElectionSession {
  id              String   @id @default(cuid())
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Chapter 1: generic Organization hierarchy links (optional for now; new
  // elections created through the new portal will set these).
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId     String?
  workspace       Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  name            String   // e.g. "SUG General Elections 2024/2025" or "2024 Board Election"
  university      String   @default("University of Lagos") // LEGACY display field
  academicSession String   // e.g. "2024/2025" — free-form period label
  startTime       DateTime
  endTime         DateTime
  accreditationStart DateTime?
  accreditationEnd   DateTime?
  status          String   @default("DRAFT") // DRAFT|PUBLISHED|ACCREDITATION|VOTING|CLOSED|CERTIFIED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  voters          Voter[]
  votes           EncryptedVote[]
  positions       Position[]
  candidates      Candidate[]
  accreditations  Accreditation[]
  auditLogs       AuditLog[]
  resultSnapshots ResultSnapshot[]
  notifications   Notification[]

  @@index([status])
  @@index([organizationId])
}

model ElectionSetting {
  id                       String   @id @default("default")
  tenantId                 String?
  tenant                   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  electionSessionId        String?
  publicLiveResults        Boolean  @default(true)
  showTurnout              Boolean  @default(true)
  requireOtp               Boolean  @default(true)
  requireAccreditation     Boolean  @default(true)
  otpTtlSeconds            Int      @default(600)
  ballotRandomization      Boolean  @default(true)
  notaEnabled              Boolean  @default(true)
  maxOtpAttempts           Int      @default(5)
  singleDeviceEnforcement  Boolean  @default(false)
  sessionTtlMinutes        Int      @default(30)
  accessTtlMinutes         Int      @default(15)
  refreshTtlDays           Int      @default(7)
  updatedAt                DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Academic structure (normalized lookups)
// ---------------------------------------------------------------------------
model Faculty {
  id        String       @id @default(cuid())
  tenantId  String?
  tenant    Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String       @unique
  createdAt DateTime     @default(now())
  departments Department[]
  programmes  Programme[]
  voters      Voter[]
  candidates  Candidate[]
  positions   Position[]      @relation("FacultyPosition")
  officials   ElectionOfficial[]
  collations  StudentCollation[]
}

model Department {
  id        String       @id @default(cuid())
  tenantId  String?
  tenant    Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String       @unique
  facultyId String
  faculty   Faculty      @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  programmes Programme[]
  voters    Voter[]
  candidates Candidate[]
  positions Position[]   @relation("DepartmentPosition")
  officials ElectionOfficial[]
  collations StudentCollation[]
}

model Programme {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  facultyId    String
  faculty      Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  durationYears Int     @default(4)
  createdAt    DateTime @default(now())
  voters       Voter[]
}

model Level {
  id    String @id @default(cuid())
  code  String @unique // 100, 200, 300, 400, 500, 600
  name  String
  order Int
}

// ---------------------------------------------------------------------------
// Political parties (optional — many SUG elections are non-partisan)
// ---------------------------------------------------------------------------
model PoliticalParty {
  id          String      @id @default(cuid())
  name        String
  acronym     String      @unique
  colour      String?
  logoUrl     String?
  manifesto   String?
  createdAt   DateTime    @default(now())
  candidates  Candidate[]
}

// ---------------------------------------------------------------------------
// Positions & Candidates
// ---------------------------------------------------------------------------
model Position {
  id            String      @id @default(cuid())
  // Chapter 3: generic org scoping
  organizationId String?
  electionSessionId String?
  electionSession ElectionSession? @relation(fields: [electionSessionId], references: [id], onDelete: Cascade)
  title         String
  slug          String      @unique
  description   String?
  scope         String      // UNIVERSITY|FACULTY|DEPARTMENT (legacy) → ORGANIZATION|WORKSPACE|VOTER_GROUP
  maximumVotes  Int         @default(1)  // Chapter 3: how many candidates a voter can select
  displayOrder  Int         @default(0)  // Chapter 3: replaces legacy `order`
  order         Int         @default(0)  // legacy alias
  facultyId     String?
  faculty       Faculty?    @relation("FacultyPosition", fields: [facultyId], references: [id], onDelete: Cascade)
  departmentId  String?
  department    Department? @relation("DepartmentPosition", fields: [departmentId], references: [id], onDelete: Cascade)
  candidates    Candidate[]
  votes         EncryptedVote[]
  createdAt     DateTime    @default(now())

  @@index([electionSessionId])
  @@index([organizationId])
}

model Candidate {
  id               String      @id @default(cuid())
  // Chapter 3: generic org scoping
  organizationId   String?
  electionSessionId String?
  electionSession  ElectionSession? @relation(fields: [electionSessionId], references: [id], onDelete: Cascade)
  fullName         String
  slug             String      @unique
  positionId       String
  position         Position    @relation(fields: [positionId], references: [id], onDelete: Cascade)
  facultyId        String?
  faculty          Faculty?    @relation(fields: [facultyId], references: [id])
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id])
  programmeId      String?
  level            String?
  politicalPartyId String?
  politicalParty   PoliticalParty? @relation(fields: [politicalPartyId], references: [id])
  slogan           String?
  manifesto        String?
  campaignVideoUrl String?
  photoUrl         String?
  // Chapter 3: generic biography field (replaces cgpa)
  biography        String?
  screeningStatus  String      @default("PENDING") // PENDING|APPROVED|DISQUALIFIED|WITHDRAWN
  screeningNotes   String?
  screenedById     String?
  screenedAt       DateTime?
  cgpa             Float?
  status           String      @default("APPROVED") // APPROVED|DISQUALIFIED|WITHDRAWN (runtime eligibility)
  displayOrder     Int         @default(0)
  votes            EncryptedVote[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([positionId])
  @@index([organizationId])
  @@index([screeningStatus])
}

// ---------------------------------------------------------------------------
// Voters (students on the register) — LEGACY + Chapter 3 generic fields
// ---------------------------------------------------------------------------
// Chapter 3: the Voter model now carries generic fields (organizationId,
// firstName, lastName, metadata, verificationStatus) alongside the legacy
// academic fields (matric, facultyId, departmentId, level). The legacy fields
// are DEPRECATED and will be removed once the demo election is migrated to
// use dynamic VoterField metadata. New voters created through the Chapter 3
// flow should use firstName/lastName + metadata JSON only.
model Voter {
  id                String       @id @default(cuid())
  // Chapter 3 generic fields (nullable for backward compat)
  organizationId    String?
  electionId        String?      // generic election reference (future)
  firstName         String?
  lastName          String?
  email             String?      // Chapter 3: generic email (legacy uses institutionEmail/personalEmail)
  phone             String?      // Chapter 3: generic phone (legacy also has phone)
  status            String?      @default("ACTIVE") // Chapter 3: ACTIVE | SUSPENDED | REMOVED
  metadata          String?      // JSON: { matricNumber, faculty, department, level, employeeId, ... }
  verificationStatus String?     @default("PENDING") // PENDING | VERIFIED | REJECTED
  // Legacy academic fields (DEPRECATED — use metadata + VoterField instead)
  tenantId          String?
  tenant            Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  electionSessionId String?
  electionSession   ElectionSession? @relation(fields: [electionSessionId], references: [id], onDelete: Cascade)
  matric            String       @unique
  fullName          String
  institutionEmail  String?
  personalEmail     String?
  facultyId         String
  faculty           Faculty      @relation(fields: [facultyId], references: [id])
  departmentId      String
  department        Department   @relation(fields: [departmentId], references: [id])
  programmeId       String?
  programme         Programme?   @relation(fields: [programmeId], references: [id])
  level             String

  // Verification + email verification
  emailVerified     Boolean      @default(false)
  emailVerifyToken  String?

  // OTP state
  otpCode           String?
  otpExpiresAt      DateTime?
  otpAttempts       Int          @default(0)
  otpChannel        String?      // EMAIL|SMS|WHATSAPP
  otpIssuedAt       DateTime?

  // Session state
  sessionToken      String?      @unique
  sessionExpiresAt  DateTime?
  sessionDeviceId   String?      // bound device for this session
  verifiedAt        DateTime?

  // Voting state
  hasVoted          Boolean      @default(false)
  votedAt           DateTime?

  // Lockout (voter-side, for OTP brute force)
  lockedUntil       DateTime?
  failedOtpAttempts Int          @default(0)

  // Flagging (admin can flag for suspicious activity — flagged votes don't count)
  flagged           Boolean      @default(false)
  flaggedReason     String?
  flaggedById       String?
  flaggedBy         ElectionOfficial? @relation(fields: [flaggedById], references: [id], onDelete: SetNull)
  flaggedAt         DateTime?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  accreditations    Accreditation[]
  supportTickets    SupportTicket[]
  devices           Device[]
  sessions          Session[]
  notifications     Notification[]
  chatMessages      ChatMessage[]
  activityLogs      VoterActivityLog[]

  @@index([electionSessionId])
  @@index([organizationId])
  @@index([facultyId])
  @@index([hasVoted])
  @@index([flagged])
}

// ---------------------------------------------------------------------------
// Accreditation (pre-voting clearance, mirrors Nigerian campus practice)
// ---------------------------------------------------------------------------
model Accreditation {
  id                String   @id @default(cuid())
  electionSessionId String?
  electionSession   ElectionSession? @relation(fields: [electionSessionId], references: [id], onDelete: Cascade)
  voterId           String
  voter             Voter    @relation(fields: [voterId], references: [id], onDelete: Cascade)
  status            String   @default("APPROVED") // PENDING|APPROVED|REJECTED
  channel           String   @default("MATRIC")   // MATRIC|BIOMETRIC|PORTAL|QR
  deviceFingerprint String?
  ipAddress         String?
  accreditedAt      DateTime @default(now())
  notes             String?

  @@unique([voterId, electionSessionId])
  @@index([electionSessionId])
}

// ---------------------------------------------------------------------------
// Encrypted votes — ballot secrecy at rest
// The plaintext choice is NEVER stored. Only the encrypted ciphertext + the
// opaque voterHash + the receiptCode (returned to the voter) are persisted.
// ---------------------------------------------------------------------------
model EncryptedVote {
  id                String   @id @default(cuid())
  // Chapter 3: generic org scoping (tenant isolation for votes)
  organizationId    String?
  electionSessionId String?
  electionSession   ElectionSession? @relation(fields: [electionSessionId], references: [id], onDelete: Cascade)
  voterHash         String   // sha256(matric + pepper), opaque, not a FK
  positionId        String
  position          Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  candidateId       String?  // stored encrypted in `ciphertext`; this nullable
                             // field is ONLY populated AFTER certification for
                             // the public results snapshot, never before.
  candidate         Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  isNota            Boolean  @default(false) // also encrypted in ciphertext; mirrored here only post-certify
  // Chapter 3: encryptedReceipt (the spec's field name — alias for ciphertext + receiptCode)
  encryptedReceipt  String?  // JSON: { ciphertext, iv, keyId, receiptCode }
  ciphertext        String   // AES-256-GCM of JSON {candidateId, isNota}
  iv                String   // base64 IV
  keyId             String   // which envelope key was used (for rotation)
  receiptCode       String   @unique
  idempotencyKey    String   @unique // sha256(voterId + electionSessionId + positionId)
  createdAt         DateTime @default(now())

  @@index([positionId])
  @@index([electionSessionId])
  @@index([organizationId])
  @@index([voterHash])
}

// ---------------------------------------------------------------------------
// Election officials (RBAC) — replaces flat Admin/Observer
// ---------------------------------------------------------------------------
model ElectionOfficial {
  id              String   @id @default(cuid())
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email           String   @unique
  name            String
  role            String   // SUPER_ADMIN|ELECTORAL_COMMITTEE|FACULTY_OFFICER|DEPARTMENT_OFFICER|OBSERVER
  scopeFacultyId  String?
  scopeFaculty    Faculty? @relation(fields: [scopeFacultyId], references: [id])
  scopeDepartmentId String?
  scopeDepartment Department? @relation(fields: [scopeDepartmentId], references: [id])
  organization    String?
  passwordHash    String
  // 2FA
  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  backupCodes     String?  // JSON array of hashed codes
  // Email verification + lockout
  emailVerified   Boolean  @default(false)
  emailVerifyToken String?
  passwordResetToken String?
  passwordResetExpiresAt DateTime?
  failedAttempts  Int      @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  devices         Device[]
  sessions        Session[]
  refreshTokens   RefreshToken[]
  ticketsResolved SupportTicket[]
  certifiedBy     ResultSnapshot[]
  flaggedVoters   Voter[]
  chatMessages    ChatMessage[]
  activityActions VoterActivityLog[]

  @@index([role])
}

model Device {
  id          String   @id @default(cuid())
  voterId     String?
  voter       Voter?   @relation(fields: [voterId], references: [id], onDelete: Cascade)
  officialId  String?
  official    ElectionOfficial? @relation(fields: [officialId], references: [id], onDelete: Cascade)
  fingerprint String   // sha256(UA + screen + tz + salt)
  label       String?  // human-friendly, e.g. "Chrome on Android"
  userAgent   String?
  ipAddress   String?
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())
  trusted     Boolean  @default(false)

  @@unique([voterId, fingerprint])
  @@unique([officialId, fingerprint])
}

model Session {
  id          String   @id @default(cuid())
  voterId     String?
  voter       Voter?   @relation(fields: [voterId], references: [id], onDelete: Cascade)
  officialId  String?
  official    ElectionOfficial? @relation(fields: [officialId], references: [id], onDelete: Cascade)
  deviceId    String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  lastSeenAt  DateTime @default(now())

  @@index([voterId])
  @@index([officialId])
}

model RefreshToken {
  id          String   @id @default(cuid())
  officialId  String
  official    ElectionOfficial @relation(fields: [officialId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique // sha256 of the refresh token
  family      String   // token family id (for theft detection)
  deviceId    String?
  ipAddress   String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime? // set on rotation or revocation

  @@index([officialId])
  @@index([family])
}

// ---------------------------------------------------------------------------
// Audit log — hash-chained (tamper-evident)
// ---------------------------------------------------------------------------
model AuditLog {
  id           String    @id @default(cuid())
  // Chapter 3: generic org scoping + resource tracking
  organizationId String?
  electionId   String?
  election     ElectionSession? @relation(fields: [electionId], references: [id], onDelete: Cascade)
  actorId      String
  actorRole    String    // SUPER_ADMIN|ELECTORAL_COMMITTEE|FACULTY_OFFICER|DEPARTMENT_OFFICER|OBSERVER|VOTER|SYSTEM
  actorName    String
  action       String
  // Chapter 3: resource + resourceId for granular audit tracking
  resource     String?   // "election" | "voter" | "candidate" | "domain" | "settings" | ...
  resourceId   String?   // the ID of the affected resource
  details      String?   // JSON string
  ip           String?
  // Chapter 3: device + browser for forensic audit
  device       String?   // device label/fingerprint
  browser      String?   // user-agent
  prevHash     String    // hash of the previous row (genesis = "GENESIS")
  hash         String    // sha256(prevHash + actorId + action + details + createdAt + nonce)
  nonce        String
  createdAt    DateTime  @default(now())

  @@index([actorId])
  @@index([organizationId])
  @@index([createdAt])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Security events (separate from audit — for alerting/anomaly detection)
// ---------------------------------------------------------------------------
model SecurityEvent {
  id         String   @id @default(cuid())
  severity   String   // LOW|MEDIUM|HIGH|CRITICAL
  category   String   // AUTH_FAILURE|OTP_BURST|DEVICE_CHANGE|RATE_LIMIT|AUDIT_TAMPER|SUSPICIOUS
  actorId    String?
  actorEmail String?
  ipAddress  String?
  message    String
  details    String?  // JSON
  resolved   Boolean  @default(false)
  resolvedById String?
  resolvedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([severity])
  @@index([category])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Support tickets & notifications
// ---------------------------------------------------------------------------
model SupportTicket {
  id           String    @id @default(cuid())
  // Chapter 3: generic org scoping + assignment tracking
  organizationId String?
  voterId      String?
  voter        Voter?    @relation(fields: [voterId], references: [id], onDelete: SetNull)
  voterMatric  String
  voterName    String
  openedBy     String?   // Chapter 3: who opened the ticket
  assignedTo   String?   // Chapter 3: who is assigned to handle it
  category     String?   // Chapter 3: "TECHNICAL" | "OTP" | "VERIFICATION" | "BILLING" | "OTHER"
  issueType    String
  description  String
  status       String    @default("OPEN")
  priority     String    @default("NORMAL")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   ElectionOfficial? @relation(fields: [resolvedById], references: [id], onDelete: SetNull)
  resolution   String?
  messages     SupportMessage[]

  @@index([status])
  @@index([organizationId])
}

model Notification {
  id        String   @id @default(cuid())
  electionSessionId String?
  electionSession ElectionSession? @relation(fields: [electionSessionId], references: [id], onDelete: Cascade)
  voterId   String?
  voter     Voter?   @relation(fields: [voterId], references: [id], onDelete: Cascade)
  officialId String?
  title     String
  message   String
  type      String   @default("INFO") // INFO|SUCCESS|WARNING|SECURITY
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([voterId])
  @@index([officialId])
}

// ---------------------------------------------------------------------------
// Certified result snapshots (HMAC-signed, tamper-evident)
// ---------------------------------------------------------------------------
model ResultSnapshot {
  id            String   @id @default(cuid())
  electionId    String
  election      ElectionSession @relation(fields: [electionId], references: [id], onDelete: Cascade)
  snapshot      String   // JSON of all results at certification
  signature     String   // HMAC-SHA256(snapshot + secret)
  totalVotes    Int
  turnoutPct    Float
  certifiedById String?
  certifiedBy   ElectionOfficial? @relation(fields: [certifiedById], references: [id], onDelete: SetNull)
  certifiedAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Chat messages — recorded conversations between voters and officials
// ---------------------------------------------------------------------------
model ChatMessage {
  id          String   @id @default(cuid())
  voterId     String?
  voter       Voter?   @relation(fields: [voterId], references: [id], onDelete: Cascade)
  officialId  String?
  official    ElectionOfficial? @relation(fields: [officialId], references: [id], onDelete: SetNull)
  sender      String   // VOTER | BOT | OFFICIAL
  content     String
  // For photo/file attachments — stored as base64 data URLs or file paths
  attachments String?  // JSON array of {type: 'image'|'file', name, dataUrl}
  // Conversation threading
  threadId    String   // groups messages in a conversation
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([voterId])
  @@index([threadId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Voter activity log — tracks voter lifecycle events (NOT vote choices)
// ---------------------------------------------------------------------------
model VoterActivityLog {
  id          String   @id @default(cuid())
  voterId     String?
  voter       Voter?   @relation(fields: [voterId], references: [id], onDelete: Cascade)
  actionById  String?
  actionBy    ElectionOfficial? @relation(fields: [actionById], references: [id], onDelete: SetNull)
  action      String   // LOGIN | VERIFY_MATRIC | SEND_OTP | VERIFY_OTP | ACCREDIT | VOTE_CAST | FLAG | UNFLAG | OTP_RESEND_BY_ADMIN | LOGOUT
  details     String?  // JSON
  ipAddress   String?
  deviceLabel String?
  createdAt   DateTime @default(now())

  @@index([voterId])
  @@index([action])
  @@index([createdAt])
}
