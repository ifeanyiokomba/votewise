// ---------------------------------------------------------------------------
// Political parties (optional — many SUG elections are non-partisan)
// ---------------------------------------------------------------------------
model PoliticalParty {
  id          String      @id @default(cuid())
  name        String
  acronym     String      @unique
  colour      String?
  logoUrl     String?
  manifesto   String?
  createdAt   DateTime    @default(now())
  candidates  Candidate[]
}

// ---------------------------------------------------------------------------
// Positions & Candidates
// ---------------------------------------------------------------------------
model Position {
  id            String      @id @default(cuid())
  // Chapter 3: generic org scoping
  organizationId String?
  electionSessionId String?
  electionSession ElectionSession? @relation(fields: [electionSessionId], references: [id], onDelete: Cascade)
  title         String
  slug          String      @unique
  description   String?
  scope         String      // UNIVERSITY|FACULTY|DEPARTMENT (legacy) → ORGANIZATION|WORKSPACE|VOTER_GROUP
  maximumVotes  Int         @default(1)  // Chapter 3: how many candidates a voter can select
  displayOrder  Int         @default(0)  // Chapter 3: replaces legacy `order`
  order         Int         @default(0)  // legacy alias
  facultyId     String?
  faculty       Faculty?    @relation("FacultyPosition", fields: [facultyId], references: [id], onDelete: Cascade)
  departmentId  String?
  department    Department? @relation("DepartmentPosition", fields: [departmentId], references: [id], onDelete: Cascade)
  candidates    Candidate[]
  votes         EncryptedVote[]
  createdAt     DateTime    @default(now())

  @@index([electionSessionId])
  @@index([organizationId])
}

model Candidate {
  id               String      @id @default(cuid())
  // Chapter 3: generic org scoping
  organizationId   String?
  electionSessionId String?
  electionSession  ElectionSession? @relation(fields: [electionSessionId], references: [id], onDelete: Cascade)
  fullName         String
  slug             String      @unique
  positionId       String
  position         Position    @relation(fields: [positionId], references: [id], onDelete: Cascade)
  facultyId        String?
  faculty          Faculty?    @relation(fields: [facultyId], references: [id])
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id])
  programmeId      String?
  level            String?
  politicalPartyId String?
  politicalParty   PoliticalParty? @relation(fields: [politicalPartyId], references: [id])
  slogan           String?
  manifesto        String?
  campaignVideoUrl String?
  photoUrl         String?
  // Chapter 3: generic biography field (replaces cgpa)
  biography        String?
  screeningStatus  String      @default("APPLICATION") // Part 5: APPLICATION|ELIGIBILITY_CHECK|DOCUMENT_REVIEW|APPROVED|MANIFESTO_UPLOAD|CAMPAIGN_ASSETS|PUBLISHED|DISQUALIFIED|WITHDRAWN
  screeningNotes   String?
  screenedById     String?
  screenedAt       DateTime?
  cgpa             Float?
  status           String      @default("APPROVED") // APPROVED|DISQUALIFIED|WITHDRAWN (runtime eligibility)
  displayOrder     Int         @default(0)
  votes            EncryptedVote[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([positionId])
  @@index([organizationId])
  @@index([screeningStatus])
