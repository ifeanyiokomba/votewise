// ---------------------------------------------------------------------------
// Voters (students on the register) — LEGACY + Chapter 3 generic fields
// ---------------------------------------------------------------------------
// Chapter 3: the Voter model now carries generic fields (organizationId,
// firstName, lastName, metadata, verificationStatus) alongside the legacy
// academic fields (matric, facultyId, departmentId, level). The legacy fields
// are DEPRECATED and will be removed once the demo election is migrated to
// use dynamic VoterField metadata. New voters created through the Chapter 3
// flow should use firstName/lastName + metadata JSON only.
model Voter {
  id                String       @id @default(cuid())
  // Chapter 3 generic fields (nullable for backward compat)
  organizationId    String?
  electionId        String?      // generic election reference (future)
  firstName         String?
  lastName          String?
  email             String?      // Chapter 3: generic email (legacy uses institutionEmail/personalEmail)
  phone             String?      // Chapter 3: generic phone (legacy also has phone)
  status            String?      @default("ACTIVE") // Chapter 3: ACTIVE | SUSPENDED | REMOVED
  metadata          String?      // JSON: { matricNumber, faculty, department, level, employeeId, ... }
  verificationStatus String?     @default("PENDING") // PENDING | VERIFIED | REJECTED
  // Legacy academic fields (DEPRECATED — use metadata + VoterField instead)
  tenantId          String?
  tenant            Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  electionSessionId String?
  electionSession   ElectionSession? @relation(fields: [electionSessionId], references: [id], onDelete: Cascade)
  matric            String       @unique
  fullName          String
  institutionEmail  String?
  personalEmail     String?
  facultyId         String
  faculty           Faculty      @relation(fields: [facultyId], references: [id])
  departmentId      String
  department        Department   @relation(fields: [departmentId], references: [id])
  programmeId       String?
  programme         Programme?   @relation(fields: [programmeId], references: [id])
  level             String

  // Verification + email verification
  emailVerified     Boolean      @default(false)
  emailVerifyToken  String?

  // OTP state
  otpCode           String?
  otpExpiresAt      DateTime?
  otpAttempts       Int          @default(0)
  otpChannel        String?      // EMAIL|SMS|WHATSAPP
  otpIssuedAt       DateTime?

  // Session state
  sessionToken      String?      @unique
  sessionExpiresAt  DateTime?
  sessionDeviceId   String?      // bound device for this session
  verifiedAt        DateTime?

  // Voting state
  hasVoted          Boolean      @default(false)
  votedAt           DateTime?

  // Lockout (voter-side, for OTP brute force)
  lockedUntil       DateTime?
  failedOtpAttempts Int          @default(0)

  // Flagging (admin can flag for suspicious activity — flagged votes don't count)
  flagged           Boolean      @default(false)
  flaggedReason     String?
  flaggedById       String?
  flaggedBy         ElectionOfficial? @relation(fields: [flaggedById], references: [id], onDelete: SetNull)
  flaggedAt         DateTime?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  accreditations    Accreditation[]
  supportTickets    SupportTicket[]
  devices           Device[]
  sessions          Session[]
  notifications     Notification[]
  chatMessages      ChatMessage[]
  activityLogs      VoterActivityLog[]

  @@index([electionSessionId])
  @@index([organizationId])
  @@index([facultyId])
  @@index([hasVoted])
  @@index([flagged])
}

// ---------------------------------------------------------------------------
// Accreditation (pre-voting clearance, mirrors Nigerian campus practice)
// ---------------------------------------------------------------------------
model Accreditation {
  id                String   @id @default(cuid())
  electionSessionId String?
  electionSession   ElectionSession? @relation(fields: [electionSessionId], references: [id], onDelete: Cascade)
  voterId           String
  voter             Voter    @relation(fields: [voterId], references: [id], onDelete: Cascade)
  status            String   @default("APPROVED") // PENDING|APPROVED|REJECTED
  channel           String   @default("MATRIC")   // MATRIC|BIOMETRIC|PORTAL|QR
  deviceFingerprint String?
  ipAddress         String?
  accreditedAt      DateTime @default(now())
  notes             String?

  @@unique([voterId, electionSessionId])
  @@index([electionSessionId])
}

// ---------------------------------------------------------------------------
// Encrypted votes — ballot secrecy at rest
// The plaintext choice is NEVER stored. Only the encrypted ciphertext + the
// opaque voterHash + the receiptCode (returned to the voter) are persisted.
// ---------------------------------------------------------------------------
model EncryptedVote {
  id                String   @id @default(cuid())
  // Chapter 3: generic org scoping (tenant isolation for votes)
  organizationId    String?
  electionSessionId String?
  electionSession   ElectionSession? @relation(fields: [electionSessionId], references: [id], onDelete: Cascade)
  voterHash         String   // sha256(matric + pepper), opaque, not a FK
  positionId        String
  position          Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  candidateId       String?  // stored encrypted in `ciphertext`; this nullable
                             // field is ONLY populated AFTER certification for
                             // the public results snapshot, never before.
  candidate         Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  isNota            Boolean  @default(false) // also encrypted in ciphertext; mirrored here only post-certify
  // Chapter 3: encryptedReceipt (the spec's field name — alias for ciphertext + receiptCode)
  encryptedReceipt  String?  // JSON: { ciphertext, iv, keyId, receiptCode }
  ciphertext        String   // AES-256-GCM of JSON {candidateId, isNota}
  iv                String   // base64 IV
  keyId             String   // which envelope key was used (for rotation)
  receiptCode       String   @unique
  idempotencyKey    String   @unique // sha256(voterId + electionSessionId + positionId)
  createdAt         DateTime @default(now())

  @@index([positionId])
  @@index([electionSessionId])
  @@index([organizationId])
  @@index([voterHash])
}

// ---------------------------------------------------------------------------
// Election officials (RBAC) — replaces flat Admin/Observer
// ---------------------------------------------------------------------------
// CHAPTER 3 (2026-08-06): generic multi-person approval mechanism for
// critical actions. Non-negotiable principle #6: "Critical election actions
// must require multi-person authorization." First consumer: disabling MFA
// on a high-privilege account (src/lib/approval.ts,
// src/app/api/auth/2fa/disable/route.ts). Chapters 5 (election state
// transitions) and 4/8 (credential/OTP overrides) are expected to reuse
// this same mechanism rather than inventing their own -- actionType is a
// free-form string specifically so new consumers don't need a schema
// change to adopt it.
model PrivilegedActionApproval {
  id                String    @id @default(cuid())
  organizationId    String?   // null for platform-level actions
  actionType        String    // e.g. "MFA_DISABLE" -- Chapter 5+ will add more
  resourceId        String    // the entity being acted on, e.g. the official's own id
  requestedById     String
  requiredApprovals Int       @default(1)
  status            String    @default("PENDING") // PENDING | APPROVED | REJECTED | EXPIRED
  reason            String?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  resolvedAt        DateTime?
  votes             PrivilegedActionApprovalVote[]

  @@index([organizationId])
  @@index([status])
  @@index([resourceId, actionType])
}

model PrivilegedActionApprovalVote {
  id         String   @id @default(cuid())
  requestId  String
  request    PrivilegedActionApproval @relation(fields: [requestId], references: [id])
  approverId String
  decision   String   // APPROVE | REJECT
  createdAt  DateTime @default(now())

  @@unique([requestId, approverId]) // one vote per approver per request
}

model ElectionOfficial {
  id              String   @id @default(cuid())
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email           String   @unique
  name            String
  role            String   // SUPER_ADMIN|ELECTORAL_COMMITTEE|FACULTY_OFFICER|DEPARTMENT_OFFICER|OBSERVER
  scopeFacultyId  String?
  scopeFaculty    Faculty? @relation(fields: [scopeFacultyId], references: [id])
  scopeDepartmentId String?
  scopeDepartment Department? @relation(fields: [scopeDepartmentId], references: [id])
  organization    String?
  passwordHash    String
  // 2FA
  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  backupCodes     String?  // JSON array of hashed codes
  // Email verification + lockout
  emailVerified   Boolean  @default(false)
  emailVerifyToken String?
  passwordResetToken String?
  passwordResetExpiresAt DateTime?
  failedAttempts  Int      @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  devices         Device[]
  sessions        Session[]
  refreshTokens   RefreshToken[]
  ticketsResolved SupportTicket[]
  certifiedBy     ResultSnapshot[]
  flaggedVoters   Voter[]
  chatMessages    ChatMessage[]
  activityActions VoterActivityLog[]

  @@index([role])
}

model Device {
  id          String   @id @default(cuid())
  voterId     String?
  voter       Voter?   @relation(fields: [voterId], references: [id], onDelete: Cascade)
  officialId  String?
  official    ElectionOfficial? @relation(fields: [officialId], references: [id], onDelete: Cascade)
  fingerprint String   // sha256(UA + screen + tz + salt)
  label       String?  // human-friendly, e.g. "Chrome on Android"
  userAgent   String?
  ipAddress   String?
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())
  trusted     Boolean  @default(false)

  @@unique([voterId, fingerprint])
  @@unique([officialId, fingerprint])
}

model Session {
  id          String   @id @default(cuid())
  voterId     String?
  voter       Voter?   @relation(fields: [voterId], references: [id], onDelete: Cascade)
  officialId  String?
  official    ElectionOfficial? @relation(fields: [officialId], references: [id], onDelete: Cascade)
  deviceId    String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  lastSeenAt  DateTime @default(now())

  @@index([voterId])
  @@index([officialId])
}

model RefreshToken {
  id          String   @id @default(cuid())
  officialId  String
  official    ElectionOfficial @relation(fields: [officialId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique // sha256 of the refresh token
  family      String   // token family id (for theft detection)
  deviceId    String?
  ipAddress   String?
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime? // set on rotation or revocation

  @@index([officialId])
  @@index([family])
}

// ---------------------------------------------------------------------------
// Audit log — hash-chained (tamper-evident)
// ---------------------------------------------------------------------------
model AuditLog {
  id           String    @id @default(cuid())
  // Chapter 3: generic org scoping + resource tracking
  organizationId String?
  electionId   String?
  election     ElectionSession? @relation(fields: [electionId], references: [id], onDelete: Cascade)
  actorId      String
  actorRole    String    // SUPER_ADMIN|ELECTORAL_COMMITTEE|FACULTY_OFFICER|DEPARTMENT_OFFICER|OBSERVER|VOTER|SYSTEM
  actorName    String
  action       String
  // Chapter 3: resource + resourceId for granular audit tracking
  resource     String?   // "election" | "voter" | "candidate" | "domain" | "settings" | ...
  resourceId   String?   // the ID of the affected resource
  details      String?   // JSON string
  ip           String?
  // Chapter 3: device + browser for forensic audit
  device       String?   // device label/fingerprint
  browser      String?   // user-agent
  prevHash     String    // hash of the previous row (genesis = "GENESIS")
  hash         String    // sha256(prevHash + actorId + action + details + createdAt + nonce)
  nonce        String
  createdAt    DateTime  @default(now())

  @@index([actorId])
  @@index([organizationId])
  @@index([createdAt])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Security events (separate from audit — for alerting/anomaly detection)
// ---------------------------------------------------------------------------
model SecurityEvent {
  id         String   @id @default(cuid())
  severity   String   // LOW|MEDIUM|HIGH|CRITICAL
  category   String   // AUTH_FAILURE|OTP_BURST|DEVICE_CHANGE|RATE_LIMIT|AUDIT_TAMPER|SUSPICIOUS
  actorId    String?
  actorEmail String?
  ipAddress  String?
  message    String
  details    String?  // JSON
  resolved   Boolean  @default(false)
  resolvedById String?
  resolvedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([severity])
  @@index([category])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Support tickets & notifications
// ---------------------------------------------------------------------------
model SupportTicket {
  id           String    @id @default(cuid())
  // Chapter 3: generic org scoping + assignment tracking
  organizationId String?
  // Chapter 11: optional election scoping (tickets raised for a specific election)
  electionId   String?
  election     ElectionSession? @relation(fields: [electionId], references: [id], onDelete: SetNull)
  voterId      String?
  voter        Voter?    @relation(fields: [voterId], references: [id], onDelete: SetNull)
  voterMatric  String
  voterName    String
  openedBy     String?   // Chapter 3: who opened the ticket
  assignedTo   String?   // Chapter 3: who is assigned to handle it (assignedToId)
  assignedToName String? // Chapter 11: denormalized assignee display name
  category     String?   // Chapter 3: "TECHNICAL" | "OTP" | "VERIFICATION" | "BILLING" | "OTHER"
  issueType    String
  description  String
  status       String    @default("OPEN")
  priority     String    @default("NORMAL")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   ElectionOfficial? @relation(fields: [resolvedById], references: [id], onDelete: SetNull)
  resolution   String?
  messages     SupportMessage[]

  @@index([status])
  @@index([organizationId])
  @@index([electionId])
}

model Notification {
  id        String   @id @default(cuid())
  electionSessionId String?
  electionSession ElectionSession? @relation(fields: [electionSessionId], references: [id], onDelete: Cascade)
  voterId   String?
  voter     Voter?   @relation(fields: [voterId], references: [id], onDelete: Cascade)
  officialId String?
  title     String
  message   String
  type      String   @default("INFO") // INFO|SUCCESS|WARNING|SECURITY
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([voterId])
  @@index([officialId])
}

// ---------------------------------------------------------------------------
// Certified result snapshots (HMAC-signed, tamper-evident)
// ---------------------------------------------------------------------------
model ResultSnapshot {
  id            String   @id @default(cuid())
  electionId    String
  election      ElectionSession @relation(fields: [electionId], references: [id], onDelete: Cascade)
  snapshot      String   // JSON of all results at certification
  signature     String   // HMAC-SHA256(snapshot + secret)
  totalVotes    Int
  turnoutPct    Float
  certifiedById String?
  certifiedBy   ElectionOfficial? @relation(fields: [certifiedById], references: [id], onDelete: SetNull)
  certifiedAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Chat messages — recorded conversations between voters and officials
// ---------------------------------------------------------------------------
model ChatMessage {
  id          String   @id @default(cuid())
  voterId     String?
  voter       Voter?   @relation(fields: [voterId], references: [id], onDelete: Cascade)
  officialId  String?
  official    ElectionOfficial? @relation(fields: [officialId], references: [id], onDelete: SetNull)
  sender      String   // VOTER | BOT | OFFICIAL
  content     String
  // For photo/file attachments — stored as base64 data URLs or file paths
  attachments String?  // JSON array of {type: 'image'|'file', name, dataUrl}
  // Conversation threading
  threadId    String   // groups messages in a conversation
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([voterId])
  @@index([threadId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Election Templates — reusable election configurations saved from past
// elections (or seeded as built-ins). Contains the election config + positions
// + candidates as JSON, so it can be applied to create a new election with the
// same structure in one click.
// ---------------------------------------------------------------------------

/// ElectionTemplate — a reusable election configuration saved from a past election.
/// Contains the election config + positions + candidates as JSON, so it can be
/// applied to create a new election with the same structure.
model ElectionTemplate {
  id              String   @id @default(cuid())
  organizationId  String
  name            String   // template name (e.g. "Annual SUG Elections Template")
  description     String?
  category        String?  // Student Union, Executive, Board, etc.
  electionType    String?  // General, Single Position, etc.
  votingMethod    String?  // Single Choice, Multiple Choice, etc.
  visibility      String   @default("PRIVATE")
  settings        String?  // JSON: election settings
  // Template data (JSON snapshot of positions + candidates structure)
  templateData    String   // JSON: { positions: [{ title, description, scope, maximumVotes, candidates: [{ fullName, slogan, manifesto }] }] }
  isBuiltIn       Boolean  @default(false) // built-in templates vs org-created
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([category])
}

// ---------------------------------------------------------------------------
// Voter activity log — tracks voter lifecycle events (NOT vote choices)
// ---------------------------------------------------------------------------
model VoterActivityLog {
  id          String   @id @default(cuid())
  voterId     String?
  voter       Voter?   @relation(fields: [voterId], references: [id], onDelete: Cascade)
  actionById  String?
  actionBy    ElectionOfficial? @relation(fields: [actionById], references: [id], onDelete: SetNull)
  action      String   // LOGIN | VERIFY_MATRIC | SEND_OTP | VERIFY_OTP | ACCREDIT | VOTE_CAST | FLAG | UNFLAG | OTP_RESEND_BY_ADMIN | LOGOUT
  details     String?  // JSON
  ipAddress   String?
  deviceLabel String?
  createdAt   DateTime @default(now())

  @@index([voterId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Election Incidents — real-time incident reports by observers during an
// election. Examples: voter intimidation, system malfunction, irregularity,
// dispute, technical issue. Used by the Observer Incident Dashboard.
// ---------------------------------------------------------------------------
/// ElectionIncident — real-time incidents reported by observers during an election.
/// Examples: voter intimidation, system malfunction, irregularity, dispute.
model ElectionIncident {
  id              String   @id @default(cuid())
  organizationId  String
  electionId      String?
  reportedById    String?  // observer member ID
  reportedByName  String
  type            String   // VOTER_INTIMIDATION | SYSTEM_MALFUNCTION | IRREGULARITY | DISPUTE | TECHNICAL_ISSUE | OTHER
  severity        String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status          String   @default("OPEN") // OPEN | INVESTIGATING | RESOLVED | ESCALATED | DISMISSED
  title           String
  description     String
  location        String?  // polling unit, faculty, department, etc.
  affectedVoterId String?
  metadata        String?  // JSON: { device, ip, timestamp, evidence }
  assignedToId    String?
  assignedToName  String?
  resolvedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([electionId])
  @@index([organizationId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// CHAPTER: Notification Scheduling — auto-sends notifications when a trigger
// event occurs (voting opens, voting closes, results published) or at a
// custom datetime. Checked by a background poller since SQLite has no native
// job scheduler.
// ---------------------------------------------------------------------------

/// ScheduledNotification — auto-sends a notification when a trigger event
/// occurs (voting opens, voting closes, results published). Checked by a
/// background poller since SQLite has no native job scheduler.
model ScheduledNotification {
  id              String   @id @default(cuid())
  organizationId  String
  electionId      String?
  trigger         String   // VOTING_OPENED | VOTING_CLOSED | RESULTS_PUBLISHED | CUSTOM_DATETIME
  triggerAt       DateTime // when to send (for CUSTOM_DATETIME) or the event time
  title           String
  message         String
  type            String   @default("INFO") // INFO|SUCCESS|WARNING|SECURITY
  target          String   @default("ALL_VOTERS") // ALL_VOTERS | VERIFIED_ONLY | CUSTOM
  targetVoterIds  String?  // JSON array if target=CUSTOM
  status          String   @default("PENDING") // PENDING | SENT | CANCELLED | FAILED
  sentAt          DateTime?
  recipientCount  Int      @default(0)
  createdBy       String?
  createdByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([electionId])
  @@index([organizationId])
  @@index([status])
  @@index([triggerAt])
}

// ---------------------------------------------------------------------------
// CHAPTER: Notification Delivery Tracking — tracks the delivery status of
// each notification per recipient × channel. One Notification can have many
// deliveries (e.g. EMAIL + IN_APP for one voter). Used by the Delivery
// Tracking dashboard so officials can see exactly which voters received,
// read, or failed to receive each notification.
// ---------------------------------------------------------------------------

/// NotificationDelivery — tracks the delivery status of a notification per
/// recipient. One Notification can have many deliveries (one per channel:
/// email, SMS, WhatsApp).
model NotificationDelivery {
  id              String   @id @default(cuid())
  notificationId  String
  voterId         String?
  channel         String   // EMAIL | SMS | WHATSAPP | IN_APP
  status          String   @default("PENDING") // PENDING | SENT | DELIVERED | READ | FAILED | BOUNCED
  recipientAddress String?  // masked email/phone (e.g. "v***@demo.com")
  externalId      String?  // provider message ID (for tracking)
  errorCode       String?
  errorMessage    String?
  sentAt          DateTime?
  deliveredAt     DateTime?
  readAt          DateTime?
  attempts        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([notificationId])
  @@index([voterId])
  @@index([status])
  @@index([channel])
}

/// CandidateTally — maintained per-candidate vote count. Incremented atomically
/// inside the vote-recorder transaction so live results never need to scan all
/// VoteRecord rows. Read cost is O(positions × candidates), not O(votes).
model CandidateTally {
  id          String   @id @default(cuid())
  electionId  String
  positionId  String
  candidateId String?  // null = NOTA
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([electionId, positionId, candidateId])
  @@index([electionId])
  @@index([positionId])
}

// ===========================================================================
// CHAPTER 11 — ELECTION INTEGRITY, FRAUD DETECTION & INCIDENT RESPONSE (EIFDIRS)
// ===========================================================================

/// IntegrityEvent — every action in VoteWise becomes an event. This is the
/// central event stream for the Election SOC. Events are normalized, stored,
/// analyzed, and scored. Suspicious events become FraudIncidents.
model IntegrityEvent {
  id              String   @id @default(cuid())
  organizationId  String?
  electionId      String?
  voterId         String?
  actorId         String?   // who performed the action
  actorName       String?
  actorRole       String?   // VOTER | OBSERVER | ADMIN | ORG_OWNER | PLATFORM_ADMIN | SYSTEM
  eventType       String   // LOGIN | LOGOUT | OTVP_GENERATED | VOTE_STARTED | VOTE_SUBMITTED | ADMIN_ACTION | etc.
  category        String   // IDENTITY | AUTHENTICATION | VOTING | ADMIN | OBSERVER | INFRASTRUCTURE | NETWORK | AUTOMATION
  severity        String   @default("INFO") // INFO | LOW | MEDIUM | HIGH | CRITICAL
  riskScore       Int      @default(0)      // 0-100, contributes to the actor's aggregate risk
  description     String
  metadata        String?  // JSON: { ip, device, browser, country, vpn, ... }
  ipAddress       String?
  deviceFingerprint String?
  detected        Boolean  @default(false)  // true if flagged by fraud detector
  incidentId      String?  // linked FraudIncident if detected
  createdAt       DateTime @default(now())

  @@index([electionId])
  @@index([organizationId])
  @@index([actorId])
  @@index([eventType])
  @@index([category])
  @@index([severity])
  @@index([detected])
  @@index([createdAt])
}

/// FraudIncident — every anomaly becomes an incident with a full lifecycle.
/// Detected → Open → Assigned → Investigating → Containment → Resolved → Closed → Archived
model FraudIncident {
  id              String   @id @default(cuid())
  incidentNumber  String   @unique  // INC-000001 format
  organizationId  String?
  electionId      String?
  title           String
  description     String
  category        String   // IDENTITY_FRAUD | LOGIN_ABUSE | OTVP_ABUSE | SESSION_ABUSE | SHARED_DEVICE | NETWORK_ANOMALY | VOTE_TIMING | TURNOUT_ANOMALY | ADMIN_ABUSE | OBSERVER_ABUSE | AUTOMATION | OTHER
  severity        String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status          String   @default("OPEN") // DETECTED | OPEN | ASSIGNED | INVESTIGATING | CONTAINMENT | RESOLVED | CLOSED | ARCHIVED
  riskScore       Int      @default(0)  // 0-100
  detectedAt      DateTime @default(now())
  detectedBy      String?  // SYSTEM | observer name | admin name
  assignedToId    String?
  assignedToName  String?
  evidence        String?  // JSON: array of evidence items
  investigationNotes String? // JSON: array of { note, author, timestamp }
  resolution      String?  // how it was resolved
  resolvedAt      DateTime?
  resolvedById    String?
  resolvedByName  String?
  falsePositive   Boolean  @default(false)
  relatedEventIds String?  // JSON array of IntegrityEvent IDs
  chainOfCustody  String?  // JSON: array of custody steps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([electionId])
  @@index([organizationId])
  @@index([status])
  @@index([severity])
  @@index([category])
  @@index([createdAt])
}

/// ElectionLock — when voting begins, critical configuration is automatically
/// locked. Any attempt to modify locked configuration creates an incident
/// unless an Emergency Override is used.
model ElectionLock {
  id              String   @id @default(cuid())
  electionId      String   @unique
  organizationId  String?
  lockedAt        DateTime @default(now())
  lockedById      String?
  lockedByName    String?
  // What's locked
  candidatesLocked    Boolean @default(true)
  positionsLocked     Boolean @default(true)
  rulesLocked         Boolean @default(true)
  eligibilityLocked   Boolean @default(true)
  ballotLocked        Boolean @default(true)
  settingsLocked      Boolean @default(true)
  // Emergency override
  emergencyOverrides  Int     @default(0)
  lastOverrideAt      DateTime?
  lastOverrideReason  String?
  lastOverrideById    String?
  lastOverrideByName  String?
  // Lockdown (platform-admin initiated freeze)
  lockedDown      Boolean  @default(false)
  lockedDownAt    DateTime?
  lockedDownById  String?
  lockedDownByName String?
  lockedDownReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// IntegrityCertificate — generated after certification. A signed report
/// containing the election's integrity score, threat summary, incident summary,
/// and audit hash. Downloadable as PDF.
model IntegrityCertificate {
  id              String   @id @default(cuid())
  electionId      String   @unique
  organizationId  String?
  electionName    String
  // Summary stats
  totalEligible   Int      @default(0)
  totalVotes      Int      @default(0)
  turnoutPct      Float    @default(0)
  integrityScore  Float    @default(100)  // 0-100
  threatLevel     String   @default("LOW") // LOW | MODERATE | ELEVATED | HIGH | CRITICAL
  // Incident summary
  totalIncidents      Int  @default(0)
  resolvedIncidents   Int  @default(0)
  criticalIncidents   Int  @default(0)
  falsePositives      Int  @default(0)
  // Security events
  totalEvents         Int  @default(0)
  detectedEvents      Int  @default(0)
  blockedAttempts     Int  @default(0)
  // Observer report
  observersAssigned   Int  @default(0)
  observerActions     Int  @default(0)
  // System
  systemAvailability  Float @default(100) // uptime %
  otvpDeliveryRate    Float @default(100)
  // Cryptographic
  auditHash           String  // SHA-256 of all integrity events
  certificationSignature String  // HMAC-SHA256(auditHash + secret)
  // Chain of custody
  certifiedById       String?
  certifiedByName     String?
  certifiedAt         DateTime @default(now())
  // Full report data (JSON)
  reportData          String  // JSON: full report for PDF generation
  createdAt           DateTime @default(now())

  @@index([electionId])
  @@index([organizationId])
}

// ===========================================================================
// CHAPTER 12 — COMMUNICATION, NOTIFICATION & SUPPORT ECOSYSTEM (CNSE)
// ===========================================================================

/// MessageTemplate — customizable, multilingual notification templates.
/// Organizations can customize built-in templates or create their own.
model MessageTemplate {
  id              String   @id @default(cuid())
  organizationId  String?  // null = built-in (available to all orgs)
  name            String
  category        String   // AUTHENTICATION | ELECTION | RESULTS | SUPPORT | BILLING | SECURITY | SYSTEM | MARKETING
  channel         String   // EMAIL | SMS | WHATSAPP | IN_APP
  language        String   @default("en") // en | fr | yo | ha | ig | ...
  subject         String?
  body            String   // template with {{variables}}
  variables       String?  // JSON array of available variable names
  isBuiltIn       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdBy       String?
  createdByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([category])
  @@index([channel])
}

/// MessageQueue — every message passes through the queue before delivery.
/// Tracks the full delivery lifecycle: QUEUED → SENDING → DELIVERED →
/// OPENED → CLICKED → FAILED. Supports retry + channel fallback.
model MessageQueue {
  id              String   @id @default(cuid())
  organizationId  String?
  electionId      String?
  recipientId     String?  // voter or member ID
  recipientName   String?
  recipientAddress String? // masked email/phone
  channel         String   // EMAIL | SMS | WHATSAPP | IN_APP
  fallbackChannel String?  // next channel to try if this one fails
  category        String   // AUTHENTICATION | ELECTION | RESULTS | SUPPORT | SECURITY | SYSTEM
  priority        String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  subject         String?
  body            String
  templateId      String?
  status          String   @default("QUEUED") // QUEUED | SENDING | DELIVERED | OPENED | CLICKED | FAILED | RETRYING
  attempts        Int      @default(0)
  maxAttempts     Int      @default(3)
  lastAttemptAt   DateTime?
  deliveredAt     DateTime?
  openedAt        DateTime?
  clickedAt       DateTime?
  failedAt        DateTime?
  errorMessage    String?
  externalId      String?  // provider message ID
  metadata        String?  // JSON: { ip, device, relatedTicketId, ... }
  relatedNotificationId String? // link to Notification record
  scheduledAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([electionId])
  @@index([recipientId])
  @@index([status])
  @@index([channel])
  @@index([category])
  @@index([priority])
  @@index([scheduledAt])
  @@index([createdAt])
}

/// Announcement — organization-published notices visible to voters/admins.
model Announcement {
  id              String   @id @default(cuid())
  organizationId  String
  electionId      String?
  title           String
  body            String
  type            String   @default("INFO") // INFO | NOTICE | WARNING | EMERGENCY | RESULT
  targetAudience  String   @default("ALL") // ALL | VOTERS | ADMINS | OBSERVERS | CANDIDATES
  isPinned        Boolean  @default(false)
  isPublished     Boolean  @default(true)
  publishedAt     DateTime @default(now())
  expiresAt       DateTime?
  createdById     String?
  createdByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([electionId])
  @@index([type])
  @@index([isPublished])
}

/// KnowledgeBaseArticle — org-specific help articles to reduce support load.
model KnowledgeBaseArticle {
  id              String   @id @default(cuid())
  organizationId  String?
  title           String
  slug            String   @unique
  body            String
  category        String   @default("GENERAL") // HOW_TO | FAQ | RULES | TROUBLESHOOTING | GENERAL
  tags            String?  // JSON array of tags
  views           Int      @default(0)
  helpfulCount    Int      @default(0)
  notHelpfulCount Int      @default(0)
  isPublished     Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([category])
  @@index([isPublished])
}

/// ObserverReport — structured reports submitted by election observers.
/// Included in the final certification package.
model ObserverReport {
  id              String   @id @default(cuid())
  organizationId  String
  electionId      String?
  observerId      String?  // OrganizationMember ID
  observerName    String
  observation     String   // what was observed
  severity        String   @default("INFO") // INFO | LOW | MEDIUM | HIGH | CRITICAL
  evidence        String?  // JSON array of { type, description, data }
  recommendation  String?  // observer's recommendation
  attachments     String?  // JSON array of { name, url }
  status          String   @default("SUBMITTED") // SUBMITTED | REVIEWED | ACCEPTED | REJECTED
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([electionId])
  @@index([organizationId])
  @@index([severity])
  @@index([status])
}

/// DataRetentionPolicy — organization-level data retention configuration.
/// Controls how long different data types are kept before archiving/deletion.
model DataRetentionPolicy {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  // Retention periods in days (0 = keep forever)
  voteRecordsDays     Int  @default(2555)   // 7 years (compliance default)
  auditLogsDays       Int  @default(2555)   // 7 years
  integrityEventsDays Int  @default(365)    // 1 year
  incidentsDays       Int  @default(2555)   // 7 years
  messagesDays        Int  @default(90)     // 90 days
  supportTicketsDays  Int  @default(365)    // 1 year
  notificationsDays   Int  @default(90)     // 90 days
  // Actions
  archiveAfterDays    Boolean @default(true) // archive before delete
  autoDeleteEnabled   Boolean @default(false) // auto-delete expired data
  // Config
  lastPolicyReview    DateTime?
  createdById         String?
  createdByName       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([organizationId])
}

// ===========================================================================
// CHAPTER 14 — BILLING, SUBSCRIPTIONS, PAYMENTS & COMMERCIAL MANAGEMENT (BSPCM)
// ===========================================================================

/// PricingPlan — configurable pricing plans. Not hardcoded — the Pricing Engine
/// reads from this table to generate quotes.
model PricingPlan {
  id              String   @id @default(cuid())
  name            String   // FREE | PAYG | PROFESSIONAL | ENTERPRISE | GOVERNMENT | WHITE_LABEL
  displayName     String
  description     String?
  // Pricing model
  model           String   // PER_ELECTION | PER_VOTER | ANNUAL | CUSTOM
  basePrice       Float    @default(0) // base price in smallest currency unit
  perVoterPrice   Float    @default(0) // price per eligible voter
  perElectionPrice Float   @default(0) // price per election
  currency        String   @default("NGN")
  // Feature inclusions
  features        String?  // JSON array of included features
  // Limits
  maxVoters       Int      @default(0) // 0 = unlimited
  maxElections    Int      @default(0) // 0 = unlimited
  maxObservers    Int      @default(0) // 0 = unlimited
  // Status
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@index([model])
}

/// PricingRule — dynamic pricing rules (tiered, volume discounts, etc.)
/// Example: first 500 voters free, 501-5000 at ₦100/voter, 5001+ at ₦80/voter
model PricingRule {
  id              String   @id @default(cuid())
  planId          String?
  name            String
  type            String   // TIERED | VOLUME_DISCOUNT | FEATURE_ADDON | SEASONAL | EDUCATIONAL
  // Tier boundaries
  minQuantity     Int      @default(0) // e.g. 0, 501, 5001
  maxQuantity     Int      @default(0) // 0 = unlimited
  // Pricing
  pricePerUnit    Float    @default(0)
  discountPercent Float    @default(0)
  fixedDiscount   Float    @default(0)
  // Feature addon
  featureName     String?  // e.g. "whatsapp_notifications", "custom_domain"
  featurePrice    Float    @default(0)
  // Conditions
  condition       String?  // JSON: { orgType, region, etc. }
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([planId])
  @@index([type])
}

/// Quote — generated quotations for organizations.
model Quote {
  id              String   @id @default(cuid())
  quoteNumber     String   @unique // QUO-000001
  organizationId  String?
  organizationName String?
  // Line items (JSON array of { description, quantity, unitPrice, total })
  items           String
  // Pricing breakdown
  subtotal        Float
  taxRate         Float    @default(0)
  taxAmount       Float    @default(0)
  discountPercent Float    @default(0)
  discountAmount  Float    @default(0)
  grandTotal      Float
  currency        String   @default("NGN")
  // Validity
  validUntil      DateTime
  status          String   @default("DRAFT") // DRAFT | SENT | ACCEPTED | REJECTED | EXPIRED | CONVERTED
  // Metadata
  estimatedVoters Int?
  estimatedElections Int?
  requestedFeatures String? // JSON array
  notes           String?
  createdById     String?
  createdByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

/// Invoice — generated invoices (from accepted quotes or direct purchases).
model Invoice {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique // INV-000001
  organizationId  String
  organizationName String?
  quoteId         String?  // linked quote if generated from one
  // Line items
  items           String   // JSON array
  // Amounts
  subtotal        Float
  taxRate         Float    @default(0)
  taxAmount       Float    @default(0)
  discountAmount  Float    @default(0)
  grandTotal      Float
  amountPaid      Float    @default(0)
  currency        String   @default("NGN")
  // Status
  status          String   @default("DRAFT") // DRAFT | SENT | PAID | PARTIALLY_PAID | OVERDUE | CANCELLED | REFUNDED
  dueDate         DateTime
  paidAt          DateTime?
  sentAt          DateTime?
  // Payment info
  paymentMethod   String?  // PAYSTACK | FLUTTERWAVE | STRIPE | BANK_TRANSFER
  paymentReference String? // gateway transaction reference
  // Metadata
  notes           String?
  createdById     String?
  createdByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([dueDate])
}

/// Payment — individual payment transactions.
model Payment {
  id              String   @id @default(cuid())
  paymentReference String  @unique // gateway reference
  organizationId  String
  invoiceId       String?
  // Amount
  amount          Float
  currency        String   @default("NGN")
  // Gateway
  gateway         String   // PAYSTACK | FLUTTERWAVE | STRIPE
  gatewayResponse String?  // JSON: full gateway response
  // Status
  status          String   @default("INITIATED") // INITIATED | PROCESSING | VERIFIED | FAILED | REFUNDED
  initiatedAt     DateTime @default(now())
  verifiedAt      DateTime?
  failedAt        DateTime?
  // Failure info
  failureReason   String?
  // Metadata
  customerEmail   String?
  customerName    String?
  ipAddress       String?
  metadata        String?  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([invoiceId])
  @@index([status])
  @@index([gateway])
}

/// Coupon — discount coupons.
model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique // WELCOME10, STUDENT2027
  description     String?
  type            String   // PERCENTAGE | FIXED_AMOUNT
  value           Float    // percentage (10 = 10%) or fixed amount
  currency        String   @default("NGN")
  // Limits
  maxUses         Int      @default(0) // 0 = unlimited
  usesCount       Int      @default(0)
  // Validity
  validFrom       DateTime @default(now())
  validUntil      DateTime?
  isActive        Boolean  @default(true)
  // Conditions
  minAmount       Float    @default(0) // minimum order amount
  applicablePlans String?  // JSON array of plan IDs (null = all)
  createdAt       DateTime @default(now())

  @@index([code])
  @@index([isActive])
}

/// Negotiation — custom pricing requests between orgs and platform admins.
model Negotiation {
  id              String   @id @default(cuid())
  organizationId  String
  organizationName String?
  // Request
  requestType     String   // CUSTOM_PRICING | VOLUME_DISCOUNT | ENTERPRISE | GOVERNMENT | WHITE_LABEL
  message         String   // org's request message
  proposedAmount  Float?   // org's proposed amount
  currency        String   @default("NGN")
  // Context
  voterCount      Int?
  electionCount   Int?
  orgType         String?  // UNIVERSITY | COMPANY | ASSOCIATION | CHURCH | NGO | GOVERNMENT
  // Status
  status          String   @default("REQUESTED") // REQUESTED | UNDER_REVIEW | COUNTER_OFFERED | ACCEPTED | REJECTED | EXPIRED
  // Negotiation thread
  thread          String?  // JSON array of { author, message, timestamp, role }
  // Resolution
  agreedAmount    Float?
  quoteId         String?  // generated quote if accepted
  // Admin
  assignedToId    String?
  assignedToName  String?
  resolvedAt      DateTime?
  resolvedById    String?
  resolvedByName  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([requestType])
}

/// Refund — refund requests and processing.
model Refund {
  id              String   @id @default(cuid())
  refundNumber    String   @unique // REF-000001
  organizationId  String
  paymentId       String
  invoiceId       String?
  // Amount
  amount          Float
  currency        String   @default("NGN")
  reason          String
  // Status
  status          String   @default("REQUESTED") // REQUESTED | REVIEWED | APPROVED | PROCESSED | COMPLETED | REJECTED
  // Workflow
  requestedById   String?
  requestedByName String?
  reviewedById    String?
  reviewedByName  String?
  reviewedAt      DateTime?
  processedAt     DateTime?
  completedAt     DateTime?
  // Gateway
  gatewayRefundRef String? // gateway refund reference
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([paymentId])
  @@index([status])
}

/// AddOnPurchase — purchases of extra features/credits.
model AddOnPurchase {
  id              String   @id @default(cuid())
  organizationId  String
  feature         String   // EXTRA_SMS | EXTRA_WHATSAPP | PREMIUM_SUPPORT | CUSTOM_DOMAIN | AI_INSIGHTS | ADVANCED_REPORTS | ADDITIONAL_STORAGE
  description     String
  quantity        Int      @default(1)
  unitPrice       Float
  totalAmount     Float
  currency        String   @default("NGN")
  invoiceId       String?  // linked invoice
  status          String   @default("PENDING") // PENDING | ACTIVE | EXPIRED | CANCELLED
  expiresAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@index([feature])
  @@index([status])
}

// ===========================================================================
// CHAPTER 15 — PLATFORM ADMINISTRATION, OPERATIONS & ECOSYSTEM MANAGEMENT (PAOEM)
// ===========================================================================

/// FeatureFlag — enable/disable features without deployment. Perfect for
/// gradual rollouts, beta testing, and emergency disabling.
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique  // e.g. "ai_reports", "white_label", "blockchain_verification"
  name        String
  description String?
  enabled     Boolean  @default(false)
  // Rollout: percentage of orgs that get the feature (0-100)
  rolloutPercent Int   @default(0)
  // Specific orgs that have access (JSON array of org IDs)
  whitelistedOrgs String? // JSON array
  // Metadata
  category    String   @default("GENERAL") // GENERAL | BETA | EXPERIMENTAL | SECURITY | BILLING
  createdById String?
  createdByName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
  @@index([category])
}

/// MaintenanceMode — platform/org/module-level maintenance. Never interrupts
/// unrelated customers.
model MaintenanceMode {
  id              String   @id @default(cuid())
  level           String   // PLATFORM | ORGANIZATION | MODULE
  organizationId  String?  // for ORGANIZATION level
  module          String?  // for MODULE level (e.g. "voting", "billing", "api")
  reason          String
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  startedById     String?
  startedByName   String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([level])
  @@index([organizationId])
  @@index([isActive])
}

/// PlatformBroadcast — platform-wide announcements targeting all or specific orgs.
model PlatformBroadcast {
  id              String   @id @default(cuid())
  title           String
  message         String
  type            String   @default("INFO") // INFO | MAINTENANCE | SECURITY | FEATURE | INCIDENT
  target          String   @default("ALL") // ALL | PLAN:ENTERPRISE | REGION:NG | ORG:specific_id
  isPublished     Boolean  @default(true)
  isDismissible   Boolean  @default(true)
  publishedAt     DateTime @default(now())
  expiresAt       DateTime?
  createdById     String?
  createdByName   String?
  createdAt       DateTime @default(now())

  @@index([isPublished])
  @@index([type])
}

// ===========================================================================
// CHAPTER 16 — API, INTEGRATIONS & DEVELOPER PLATFORM (AIDP)
// ===========================================================================

/// ApiKey — organization-scoped API keys for external integrations.
/// Each key has scopes (permissions), expiration, and usage tracking.
model ApiKey {
  id              String   @id @default(cuid())
  organizationId  String
  name            String   // "Production", "Development", "Student Portal Sync"
  keyPrefix       String   // first 8 chars for display (e.g. "vw_live_")
  keyHash         String   @unique // sha256 of the full key
  scopes          String   // JSON array: ["read:voters", "write:elections", ...]
  environment     String   @default("production") // production | sandbox
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  lastUsedIp      String?
  createdAt       DateTime @default(now())
  revokedAt       DateTime?
  createdById     String?
  createdByName   String?

  @@index([organizationId])
  @@index([keyHash])
  @@index([environment])
}

/// OAuthClient — OAuth 2.0 applications registered by organizations.
model OAuthClient {
  id              String   @id @default(cuid())
  organizationId  String
  name            String   // "University Portal Integration"
  clientId        String   @unique
  clientSecretHash String
  redirectUris    String   // JSON array of allowed redirect URIs
  scopes          String   // JSON array of requested scopes
  grantType       String   @default("authorization_code") // authorization_code | client_credentials
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([clientId])
}

/// Webhook — organization-configured webhook endpoints that receive signed
/// event notifications instead of requiring polling.
model Webhook {
  id              String   @id @default(cuid())
  organizationId  String
  url             String
  name            String   // "Student Portal Notifier"
  secret          String   // HMAC signing secret
  events          String   // JSON array: ["election.started", "vote.completed", ...]
  isActive        Boolean  @default(true)
  // Delivery stats
  totalSent       Int      @default(0)
  totalDelivered  Int      @default(0)
  totalFailed     Int      @default(0)
  lastSentAt      DateTime?
  lastStatus      Int?     // HTTP status code of last delivery
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([isActive])
}

/// WebhookDelivery — individual webhook delivery attempts with retry tracking.
model WebhookDelivery {
  id              String   @id @default(cuid())
  webhookId       String
  eventId         String   // unique event ID (prevents replay)
  eventType       String   // e.g. "election.started"
  payload         String   // JSON payload sent
  signature       String   // HMAC-SHA256 signature
  status          String   @default("PENDING") // PENDING | DELIVERED | FAILED | RETRYING
  attempts        Int      @default(0)
  maxAttempts     Int      @default(3)
  responseCode    Int?
  responseBody    String?
  nextRetryAt     DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([webhookId])
  @@index([status])
  @@index([eventType])
}

/// Integration — connected external systems (SIS, HR, identity providers, etc.)
model Integration {
  id              String   @id @default(cuid())
  organizationId  String
  name            String   // "Google Workspace", "University Portal", "SAP HR"
  type            String   // SIS | HR | IDENTITY | MEMBERSHIP | LMS | ERP | CUSTOM
  provider        String?  // google_workspace | microsoft_entra | okta | keycloak | moodle | canvas | sap | custom
  status          String   @default("DISCONNECTED") // CONNECTED | DISCONNECTED | ERROR | SYNCING
  config          String?  // JSON: provider-specific configuration
  lastSyncAt      DateTime?
  lastSyncStatus  String?  // SUCCESS | PARTIAL | FAILED
  lastError       String?
  syncCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([type])
  @@index([status])
}

/// ApiLog — every API request is logged for monitoring, analytics, and audit.
model ApiLog {
  id              String   @id @default(cuid())
  organizationId  String?
  apiKeyId        String?
  method          String   // GET | POST | PATCH | DELETE
  endpoint        String   // /api/v1/elections
  statusCode      Int
  latencyMs       Int
  ipAddress       String?
  userAgent       String?
  requestId       String?  // unique request ID for tracing
  error           String?
  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@index([apiKeyId])
  @@index([endpoint])
  @@index([statusCode])
  @@index([createdAt])
}

// ===========================================================================
// CHAPTER 17 — Production Infrastructure, Hosting & Deployment (PIHD)
// ===========================================================================

/// A single point-in-time readiness assessment run by an admin before an
/// election goes live. Acts as the "pre-flight checklist" for the platform.
model ReadinessRun {
  id              String   @id @default(cuid())
  organizationId  String?
  electionId      String?
  expectedVoters  Int      @default(0)
  ready           Boolean
  criticalFailures Int     @default(0)
  warnings        Int      @default(0)
  checksJson      String   // JSON-serialised HealthCheck[]
  triggeredBy     String?  // admin user id
  triggeredByName String?
  notes           String?
  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@index([electionId])
  @@index([createdAt])
}

/// Periodic system metric snapshot (CPU, memory, queue depth, DB size, etc.).
/// One row per scrape interval — used for the infra dashboard sparklines.
model SystemMetric {
  id          String   @id @default(cuid())
  metric      String   // cpu | memory | queueDepth | dbSizeMb | apiLatencyMs | errorRate | activeConnections | rps
  value       Float
  unit        String?
  labels      String?  // JSON object of extra labels
  createdAt   DateTime @default(now())

  @@index([metric])
  @@index([createdAt])
}

/// A database / file backup record. Tracks type, status, size, location.
model BackupRecord {
  id           String   @id @default(cuid())
  type         String   // hourly | daily | weekly | monthly | manual
  status       String   // PENDING | RUNNING | COMPLETED | FAILED
  sizeBytes    Int      @default(0)
  location     String   // s3://bucket/key | local path
  checksum     String?  // SHA-256 of the backup file
  encrypted    Boolean  @default(true)
  durationMs   Int      @default(0)
  error        String?
  triggeredBy  String?
  createdAt    DateTime @default(now())
  completedAt  DateTime?

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

/// A deployment record — tracks blue/green and canary releases.
model DeploymentRecord {
  id              String   @id @default(cuid())
  version         String   // git SHA / semver tag
  environment     String   // staging | production
  strategy        String   // blue-green | canary | rolling
  status          String   // PENDING | BUILDING | DEPLOYING | LIVE | ROLLED_BACK | FAILED
  canaryPct       Int      @default(0)  // 0/25/50/100 for canary
  commitMessage   String?
  deployedBy      String?
  healthCheckPassed Boolean @default(false)
  rollbackOf      String?  // deployment id this rolls back
  notes           String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
}

/// A custom (apex/sub) domain mapped to an organization for multi-tenant routing.
model CustomDomain {
  id              String   @id @default(cuid())
  organizationId  String
  domain          String   @unique // vote.university.edu.ng
  type            String   // apex | subdomain | wildcard
  status          String   // PENDING | VERIFYING | ACTIVE | FAILED | EXPIRED
  verificationToken String? // TXT record value
  sslStatus       String   // PENDING | ISSUING | ACTIVE | FAILED
  sslExpiresAt    DateTime?
  dnsVerifiedAt   DateTime?
  lastCheckedAt   DateTime?
  primary         Boolean  @default(false) // is this the org's primary domain?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

/// Aggregated uptime sample (one per day per service). Drives the 90-day bar.
model UptimeRecord {
  id          String   @id @default(cuid())
  service     String   // Database | Redis Cache | API | WebSocket | ...
  date        String   // YYYY-MM-DD (one row per service per day)
  uptimePct   Float    @default(100) // 99.98
  incidents   Int      @default(0)
  avgLatencyMs Int     @default(0)
  createdAt   DateTime @default(now())

  @@unique([service, date])
  @@index([service])
}

// ---------------------------------------------------------------------------
// CHAPTER 17 — Centralized Logging, Alerting, Cost Monitoring (PIHD ext.)
// ---------------------------------------------------------------------------

/// A structured log entry from ANY service (app, worker, scheduler, fraud
/// engine, analytics engine). Categories match the spec: Application,
/// Audit, Security, Infrastructure, API, Deployment.
model LogEntry {
  id            String   @id @default(cuid())
  category      String   // application | audit | security | infrastructure | api | deployment
  level         String   // debug | info | warn | error | fatal
  service       String   // app | worker | scheduler | notification | fraud-engine | analytics-engine | results-service
  message       String
  metadata      String?  // JSON blob (requestId, userId, electionId, etc.)
  requestId     String?
  organizationId String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([category])
  @@index([level])
  @@index([service])
  @@index([createdAt])
  @@index([organizationId])
}

/// An alert rule — evaluated continuously against metrics/logs. When the
/// condition is met, an AlertEvent is raised and dispatched to channels.
model AlertRule {
  id            String   @id @default(cuid())
  name          String
  description   String?
  metric        String   // cpu | memory | errorRate | latency | queueDepth | dbReplicaLag | rps | uptime
  condition     String   // gt | lt | gte | lte | eq
  threshold     Float
  windowMinutes Int      @default(5)
  severity      String   // info | warning | critical
  channels      String   // JSON array: ["email","sms","whatsapp","slack","teams"]
  enabled       Boolean  @default(true)
  cooldownMin   Int      @default(30)  // min time between repeats
  lastFiredAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([enabled])
  @@index([metric])
}

/// A fired alert event — the audit trail of every alert that triggered.
model AlertEvent {
  id          String   @id @default(cuid())
  ruleId      String?
  ruleName    String
  metric      String
  severity    String   // info | warning | critical
  message     String
  value       Float
  threshold   Float
  channels    String   // JSON array of channels attempted
  delivered   String   // JSON array of { channel, status, at }
  acknowledged Boolean @default(false)
  acknowledgedBy String?
  acknowledgedAt DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([severity])
  @@index([metric])
  @@index([createdAt])
  @@index([acknowledged])
}

/// A cost record — one row per cost line item (infra, SMS, email, compute,
/// DB, storage). Aggregated hourly/daily for the cost monitoring dashboard.
model CostRecord {
  id            String   @id @default(cuid())
  category      String   // infrastructure | compute | database | storage | sms | email | whatsapp | cdn | other
  service       String?  // aws-rds | aws-ecs | termii | resend | cloudflare | ...
  amountUsd     Float
  amountNgn     Float?
  units         Int?     // number of SMS, emails, hours, GB, etc.
  unitLabel     String?  // "SMS" | "email" | "GB-hours" | "hours"
  periodStart   DateTime
  periodEnd     DateTime
  organizationId String?  // null = platform-level cost
  createdAt     DateTime @default(now())

  @@index([category])
  @@index([service])
  @@index([periodStart])
  @@index([organizationId])
}

/// A Service Level Objective — e.g. "API p95 latency < 500ms 99.9% of the time".
/// Tracked over a rolling window (30 days). Drives the SLO dashboard card.
model SloDefinition {
  id            String   @id @default(cuid())
  name          String   // "API Latency"
  service       String   // API | Database | WebSocket | ...
  metric        String   // latency | uptime | errorRate
  target        Float    // 99.9 (percent) or 500 (ms)
  targetUnit    String   // percent | ms | seconds
  window        String   // 30d | 7d | 90d
  sliType       String   // ratio | threshold
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([service])
  @@index([enabled])
}

/// A daily SLI (Service Level Indicator) sample — one row per SLO per day.
model SloSample {
  id            String   @id @default(cuid())
  sloId         String
  date          String   // YYYY-MM-DD
  goodEvents    Int      @default(0)
  totalEvents   Int      @default(0)
  sliValue      Float    @default(100) // goodEvents/totalEvents * 100
  budgetRemaining Float  @default(100) // % of error budget remaining
  createdAt     DateTime @default(now())

  @@unique([sloId, date])
  @@index([sloId])
}

/// A postmortem document — written after an incident is resolved. Completes
/// the incident lifecycle: detect → alert → respond → POSTMORTEM → improve.
/// Spec (Ch.17 Philosophy): "Infrastructure is not an afterthought—it is part
/// of election integrity." Postmortems ensure we learn from every failure.
model Postmortem {
  id              String   @id @default(cuid())
  incidentId      String?  // link to FraudIncident or AlertEvent
  title           String
  severity        String   // critical | warning | info
  status          String   // draft | published | archived
  summary         String   // executive summary
  timeline        String   // JSON array of { time, event }
  rootCause       String   // root cause analysis
  impact          String   // user/election impact description
  whatWentWell    String   // JSON array of strings
  whatWentWrong   String   // JSON array of strings
  actionItems     String   // JSON array of { item, owner, due, status }
  lessonsLearned  String   // JSON array of strings
  authoredBy      String
  authoredByName  String
  reviewedBy      String?
  reviewedAt      DateTime?
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([incidentId])
  @@index([status])
  @@index([createdAt])
}

/// A scheduled maintenance window — planned downtime or degraded period.
/// Distinct from MaintenanceMode (which is active). This lets admins schedule
/// future windows, notify affected orgs, and auto-activate when the window starts.
model ScheduledMaintenance {
  id              String   @id @default(cuid())
  title           String
  description     String
  level           String   // PLATFORM | ORGANIZATION | MODULE
  organizationId  String?
  module          String?  // affected module (if level=MODULE)
  scheduledStart  DateTime
  scheduledEnd    DateTime
  status          String   // SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
  notifiedOrgs    Boolean  @default(false)
  createdBy        String
  createdByName   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([scheduledStart])
  @@index([organizationId])
}

// ===========================================================================
// CHAPTER 18 — Testing, Quality Assurance, Security Certification & Go-Live
//             Readiness (TQASGR)
// ===========================================================================

/// A test suite — a collection of test cases (unit / integration / e2e /
/// security / fraud-sim / performance). Each suite has a type and a target
/// module. Runs are recorded as TestRun rows.
model TestSuite {
  id          String   @id @default(cuid())
  name        String
  type        String   // unit | integration | e2e | security | fraud-sim | performance | accessibility | browser
  module      String   // sve | eifdirs | cnse | raei | bspcm | paoem | aidp | pihed | tqasgr | core
  description String?
  totalCases  Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([module])
  @@index([enabled])
}

/// A single test case within a suite. Has a status (pass/fail/skip) that's
/// updated when the suite is run.
model TestCase {
  id          String   @id @default(cuid())
  suiteId     String
  name        String
  description String?
  category    String   // happy-path | edge-case | error-handling | security | performance | a11y
  severity    String   @default("normal") // blocker | critical | major | normal | minor
  status      String   @default("pending") // pending | running | passed | failed | skipped | flaky
  durationMs  Int      @default(0)
  errorMessage String?
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([suiteId])
  @@index([status])
  @@index([severity])
}

/// A single run of a test suite. Records pass/fail counts, duration, and
/// the full result JSON for the audit trail.
model TestRun {
  id           String   @id @default(cuid())
  suiteId      String
  suiteName    String
  suiteType    String
  status       String   // running | passed | failed | partial | aborted
  totalCases   Int      @default(0)
  passed       Int      @default(0)
  failed       Int      @default(0)
  skipped      Int      @default(0)
  durationMs   Int      @default(0)
  coveragePct  Float    @default(0)
  resultsJson  String?  // JSON array of { caseId, name, status, durationMs, error }
  triggeredBy  String?
  triggeredByName String?
  startedAt    DateTime @default(now())
  completedAt  DateTime?

  @@index([suiteId])
  @@index([status])
  @@index([startedAt])
}

/// A release readiness checklist item. Each release must verify all items
/// before shipping. Spec: "All automated tests passed, Code review completed,
/// Security scan passed, Performance benchmarks met, Accessibility verified,
/// Documentation updated, Backups successful, Monitoring configured,
/// Rollback plan ready, Deployment approved."
model ReleaseChecklist {
  id          String   @id @default(cuid())
  version     String   // e.g. "v18.0.0"
  itemName    String
  category    String   // testing | code-review | security | performance | a11y | docs | backup | monitoring | rollback | approval
  required    Boolean  @default(true)
  verified    Boolean  @default(false)
  verifiedBy  String?
  verifiedAt  DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([version])
  @@index([verified])
}

/// A production go-live checklist item. Every org must verify all items
/// before launching an election. Spec: "Organization configured, Election
/// validated, Candidates approved, Voters imported, OTVP channels operational,
/// Infrastructure healthy, Monitoring active, Backup verified, SSL valid,
/// Domain verified, Support team available."
model GoLiveChecklist {
  id              String   @id @default(cuid())
  organizationId  String
  electionId      String?
  itemName        String
  category        String   // org | election | candidates | voters | otvp | infra | monitoring | backup | ssl | domain | support
  required        Boolean  @default(true)
  verified        Boolean  @default(false)
  verifiedBy      String?
  verifiedAt      DateTime?
  notes           String?
  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@index([electionId])
  @@index([verified])
}

/// A pilot election — a controlled small-scale election before general
/// availability. Spec: "Student association, Small NGO, Company committee,
/// Department election."
model PilotElection {
  id              String   @id @default(cuid())
  organizationId  String
  electionId      String?
  name            String
  type            String   // student-association | ngo | company-committee | department | faculty | other
  scale           String   // micro | small | medium | large
  expectedVoters  Int      @default(0)
  actualVoters    Int      @default(0)
  status          String   @default("PLANNED") // PLANNED | ACTIVE | COMPLETED | CANCELLED
  startDate       DateTime?
  endDate         DateTime?
  metrics         String?  // JSON: { turnout, errorRate, p95Latency, incidents }
  lessonsLearned  String?
  successCriteria String?  // JSON array of { criterion, met }
  approvedForGA   Boolean  @default(false) // approved for general availability?
  createdBy       String?
  createdByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

/// A compliance framework (ISO 27001, SOC 2, GDPR, NDPR). Tracks control
/// evidence and certification status. Spec: "Prepare for ISO 27001, SOC 2,
/// GDPR, Local data protection regulations."
model ComplianceFramework {
  id              String   @id @default(cuid())
  name            String   // ISO 27001 | SOC 2 | GDPR | NDPR (Nigeria)
  description     String?
  status          String   @default("not-started") // not-started | in-progress | certified | expired
  totalControls   Int      @default(0)
  metControls     Int      @default(0)
  certifyingBody  String?
  certificateUrl  String?
  validFrom       DateTime?
  validUntil      DateTime?
  evidence        String?  // JSON array of { control, status, evidence, lastReviewed }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

/// A digitally-signed election certification seal — the public-facing
/// "VoteWise Certification Seal" that can be verified at /certify/[id].
/// Distinct from IntegrityCertificate (Ch.11) which is the internal integrity
/// record; this is the public seal with a verification ID.
model CertificationSeal {
  id              String   @id @default(cuid())
  certificationId String   @unique // VW-2027-000184 (human-readable)
  electionId      String
  organizationId  String?
  electionName    String
  organizationName String?
  status          String   @default("CERTIFIED") // CERTIFIED | REVOKED | EXPIRED
  integrityScore  Float    @default(100)
  votesVerified   Int      @default(0)
  auditLogsComplete Boolean @default(true)
  observerReportsComplete Boolean @default(true)
  securityIncidents  String  @default("None Critical")
  certifiedBy     String   @default("VoteWise Platform")
  certifiedAt     DateTime @default(now())
  signature       String   // HMAC-SHA256 signature for verification
  revokedAt       DateTime?
  revokeReason    String?
  createdAt       DateTime @default(now())

  @@index([electionId])
  @@index([organizationId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// CHAPTER 18 ext — UAT, Release Management, Documentation Validation
// ---------------------------------------------------------------------------

/// A UAT (User Acceptance Testing) session — testing with real users
/// (platform admins, org admins, observers, candidates, voters) who provide
/// structured feedback before release.
model UatSession {
  id              String   @id @default(cuid())
  releaseVersion  String   // e.g. "v18.0.0"
  participantName String
  participantRole String   // platform-admin | org-admin | observer | candidate | voter
  scenario        String   // the user journey tested
  status          String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | BLOCKED
  feedback        String?  // free-text feedback
  rating          Int?     // 1-5 stars
  issues          String?  // JSON array of { severity, description }
  approved        Boolean  @default(false) // did the participant approve?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([releaseVersion])
  @@index([status])
  @@index([participantRole])
}

/// A release track — tracks the release phase (Alpha/Beta/RC/Stable) and
/// which feature flags are enabled for each. Spec: "Support: Alpha, Beta,
/// Release Candidate (RC), Stable. Feature flags should allow gradual rollout."
model ReleaseTrack {
  id              String   @id @default(cuid())
  version         String   @unique // e.g. "v18.0.0"
  phase           String   @default("alpha") // alpha | beta | rc | stable
  releaseDate     DateTime?
  rolloutPct      Int      @default(0) // 0-100 (canary percentage)
  featureFlags    String?  // JSON array of { flag, enabled } for this release
  changelog       String?  // markdown changelog
  knownIssues     String?  // JSON array of { issue, severity, workaround }
  status          String   @default("DRAFT") // DRAFT | SCHEDULED | LIVE | ROLLED_BACK | ARCHIVED
  approvedBy      String?
  approvedAt      DateTime?
  createdBy       String
  createdByName   String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([phase])
  @@index([status])
}

/// A documentation validation item — ensures every release updates the
/// required documentation. Spec: "Ensure every release updates: user guides,
/// API documentation, administrator manuals, observer manuals, deployment
/// documentation, change logs."
model DocValidation {
  id              String   @id @default(cuid())
  version         String   // release version
  docType         String   // user-guide | api-docs | admin-manual | observer-manual | deployment-doc | changelog
  docName         String   // specific doc name/path
  required        Boolean  @default(true)
  verified        Boolean  @default(false)
  verifiedBy      String?
  verifiedAt      DateTime?
  docUrl          String?  // link to the updated doc
  notes           String?
  createdAt       DateTime @default(now())

  @@index([version])
  @@index([verified])
  @@index([docType])
}

// ===========================================================================
// CHAPTER 16A — Communication, OTVP Delivery, Live Monitoring & Support Ops
// ===========================================================================

/// A per-channel OTVP delivery attempt. Tracks every email/SMS/WhatsApp
/// attempt for a single OTVP, with status, retry count, and error details.
/// Drives the OTVP Delivery Dashboard.
model OtpDeliveryAttempt {
  id              String   @id @default(cuid())
  organizationId  String
  electionId      String?
  voterId         String?
  voterName       String?
  credentialId    String?  // link to VotingCredential
  channel         String   // EMAIL | SMS | WHATSAPP
  destination     String   // masked (j***@gmail.com / +234***1234)
  status          String   @default("PENDING") // PENDING | SENT | DELIVERED | FAILED | RETRYING
  attempts        Int      @default(0)
  maxAttempts     Int      @default(3)
  provider        String?  // resend | termii | twilio
  providerMessageId String?
  error           String?
  cooldownUntil   DateTime?
  sentAt          DateTime?
  deliveredAt     DateTime?
  createdBy        String?  // admin/observer who triggered a resend (null = auto)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([electionId])
  @@index([voterId])
  @@index([status])
  @@index([createdAt])
}

/// A support chat conversation (thread-level). Distinct from SupportTicket
/// (which is form-based). This is real-time chat with assignment, SLA,
/// reassignment, and escalation.
model SupportConversation {
  id              String   @id @default(cuid())
  organizationId  String
  electionId      String?
  voterId         String?
  voterName       String?
  voterIdentifier String?  // matric number or email
  subject         String?
  status          String   @default("NEW") // NEW | ASSIGNED | WAITING_VOTER | WAITING_STAFF | ESCALATED | RESOLVED | CLOSED
  priority        String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  assignedToId    String?
  assignedToName  String?
  assignedAt      DateTime?
  slaDeadline     DateTime?  // response SLA deadline
  slaBreached     Boolean  @default(false)
  escalationLevel Int      @default(0) // 0=org admin, 1=observer, 2=votewise support, 3=platform admin
  category        String?  // OTP | ELIGIBILITY | TECHNICAL | OTHER
  botHandled      Boolean  @default(false) // did the chatbot handle it before human?
  resolvedAt      DateTime?
  resolvedBy      String?
  resolution      String?  // how it was resolved
  lastMessageAt   DateTime?
  lastMessagePreview String?
  unreadCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([assignedToId])
  @@index([escalationLevel])
  @@index([createdAt])
}

/// An internal staff note on a support conversation. Visible only to staff,
/// never shown to the voter. Spec: "Admins and observers can leave internal
/// notes. Visible only to staff. Never shown to the voter."
model StaffNote {
  id              String   @id @default(cuid())
  conversationId  String
  authorId        String
  authorName      String
  authorRole      String   // ADMIN | OBSERVER | SUPPORT | PLATFORM
  content         String
  pinned          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

// ===========================================================================
// ENTERPRISE AUDIT PART 2 — Database Architecture Expansion
//
// Per the CTO recommendation: "Add new enterprise modules one domain at a
// time. Maintain backward compatibility. Only perform breaking refactors
// when all dependent code has been migrated."
//
// All models below are NEW additions — they do not modify existing tables.
// This is a non-breaking schema evolution.
// ===========================================================================

// ---------------------------------------------------------------------------
// DOMAIN: FRAUD ENGINE (Critical)
// Spec: FraudCase, FraudRule, FraudScore, FraudEvidence, FraudAlert, FraudDecision
// ---------------------------------------------------------------------------

/// A fraud detection rule — configurable thresholds for each detector type.
/// Spec: "Multiple device login, Duplicate IP, VPN, Bot detection, Impossible
/// travel, High velocity. Everything recorded."
model FraudRule {
  id              String   @id @default(cuid())
  organizationId  String?
  name            String
  detector        String   // VOTE_FLOODING | GEO_ANOMALY | DEVICE_REUSE | VELOCITY | OTVP_ABUSE | SESSION_HIJACK | BALLOT_STUFFING | COORDINATED_ATTACK | VPN | BOT | DUPLICATE_IP
  enabled         Boolean  @default(true)
  threshold       Float    // detector-specific threshold
  windowMinutes   Int      @default(5)
  severity        String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  action          String   @default("ALERT") // ALERT | BLOCK | LOCK_ELECTION
  description     String?
  lastTriggeredAt DateTime?
  triggerCount    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([detector])
  @@index([enabled])
}

/// A fraud risk score — computed per voter per election. Aggregates signals
/// from all detectors into a single 0-100 score.
model FraudScore {
  id              String   @id @default(cuid())
  organizationId  String
  electionId      String?
  voterId         String?
  score           Int      @default(0) // 0-100 (0=safe, 100=certain fraud)
  level           String   @default("LOW") // LOW | MODERATE | ELEVATED | HIGH | CRITICAL
  signals         String?  // JSON array of { detector, weight, detail }
  factors         String?  // JSON: { deviceReuse, velocity, geoAnomaly, ... }
  computedAt      DateTime @default(now())

  @@index([organizationId])
  @@index([electionId])
  @@index([voterId])
  @@index([score])
}

/// Evidence attached to a FraudIncident — immutable records that prove the
/// fraud occurred. Spec: "Everything recorded."
model FraudEvidence {
  id              String   @id @default(cuid())
  incidentId      String   // link to FraudIncident
  type            String   // LOG | SCREENSHOT | NETWORK_TRACE | DEVICE_PRINT | IP_RECORD | TIMELINE | OTHER
  description     String
  data            String   // JSON: the evidence payload
  collectedBy     String?  // SYSTEM | admin name | observer name
  collectedAt     DateTime @default(now())

  @@index([incidentId])
  @@index([type])
}

/// A decision made on a fraud incident — who decided what, when, and why.
/// Creates an immutable audit trail of every fraud resolution.
model FraudDecision {
  id              String   @id @default(cuid())
  incidentId      String
  decision        String   // CONFIRMED | FALSE_POSITIVE | ESCALATED | DISMISSED | AUTO_RESOLVED
  decidedBy       String
  decidedByName   String
  reason          String?
  actionTaken     String?  // e.g. "Voter session terminated", "Election locked"
  createdAt       DateTime @default(now())

  @@index([incidentId])
  @@index([decision])
}

// ---------------------------------------------------------------------------
// DOMAIN: SESSION TRACKING (Critical)
// Spec: "LoginSession, VotingSession, AdminSession, ObserverSession. Never
// mix them."
// ---------------------------------------------------------------------------

/// A login session — tracks admin/official login sessions separately from
/// voting sessions. Spec: "Never mix them."
model LoginSession {
  id              String   @id @default(cuid())
  organizationId  String?
  officialId      String?
  sessionToken    String   @unique
  role            String   // PLATFORM_SUPER_ADMIN | ORG_OWNER | ORG_ADMIN | OBSERVER | SUPPORT_AGENT
  ipAddress       String?
  deviceFingerprint String?
  userAgent       String?
  mfaVerified     Boolean  @default(false)
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([officialId])
  @@index([organizationId])
  @@index([createdAt])
}

/// An admin session — tracks admin actions separately from voter sessions.
model AdminSession {
  id              String   @id @default(cuid())
  organizationId  String?
  officialId      String?
  sessionToken    String   @unique
  ipAddress       String?
  deviceFingerprint String?
  actions         Int      @default(0) // count of actions taken in this session
  lastActionAt    DateTime?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([officialId])
  @@index([organizationId])
}

/// An observer session — tracks observer monitoring sessions.
model ObserverSession {
  id              String   @id @default(cuid())
  organizationId  String
  officialId      String?
  electionId      String?
  sessionToken    String   @unique
  ipAddress       String?
  deviceFingerprint String?
  reportsFiled    Int      @default(0)
  incidentsFlagged Int     @default(0)
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([officialId])
  @@index([electionId])
  @@index([organizationId])
}

/// A trusted device — devices that have been verified by the user and don't
/// require additional challenge. Spec: "Device, Browser, OS, Fingerprint,
/// TrustedDevice."
model TrustedDevice {
  id              String   @id @default(cuid())
  voterId         String?
  officialId      String?
  fingerprint     String   // sha256(UA + screen + tz + salt)
  label           String?  // "Chrome on Android"
  browser         String?
  os              String?
  ipAddress       String?
  trustedAt       DateTime @default(now())
  lastUsedAt      DateTime @default(now())
  revokedAt       DateTime?

  @@index([voterId])
  @@index([officialId])
  @@index([fingerprint])
}

// ---------------------------------------------------------------------------
// DOMAIN: COMMUNICATION PROVIDERS (High)
// Spec: "EmailProvider, SMSProvider, WhatsAppProvider, ProviderHealth.
// Allows failover."
// ---------------------------------------------------------------------------

/// A communication provider configuration — stores credentials + settings
/// for each provider (Resend, Termii, Twilio, etc.). Supports failover.
model CommunicationProvider {
  id              String   @id @default(cuid())
  organizationId  String?  // null = platform-level provider
  channel         String   // EMAIL | SMS | WHATSAPP | PUSH
  providerName    String   // resend | termii | twilio | messagebird
  displayName     String   // "Resend (Primary)"
  priority        Int      @default(1) // 1=primary, 2=secondary (failover order)
  enabled         Boolean  @default(true)
  credentials     String   // JSON: encrypted API keys + config
  fromAddress     String?  // sender email/phone/name
  rateLimit       Int      @default(100) // max messages per minute
  totalSent       Int      @default(0)
  totalDelivered  Int      @default(0)
  totalFailed     Int      @default(0)
  lastUsedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([channel])
  @@index([enabled])
}

/// Provider health check — periodic pings to verify the provider is
/// responsive. Drives the failover logic.
model ProviderHealth {
  id              String   @id @default(cuid())
  providerId      String
  status          String   // HEALTHY | DEGRADED | DOWN
  latencyMs       Int      @default(0)
  errorRate       Float    @default(0) // %
  lastError       String?
  checkedAt       DateTime @default(now())

  @@index([providerId])
  @@index([checkedAt])
}

// ---------------------------------------------------------------------------
// DOMAIN: PORTAL CUSTOMIZATION (High)
// Spec: "PortalSettings, HomepageBlocks, HomepageAnnouncements,
// HomepageBanners. Every organization customizes its portal."
// ---------------------------------------------------------------------------

/// Portal settings — controls the public org portal behavior + appearance.
model PortalSettings {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  showCountdown   Boolean  @default(true)
  showStats       Boolean  @default(true)
  showCandidates  Boolean  @default(true)
  showCommittee   Boolean  @default(true)
  showTimetable   Boolean  @default(true)
  showAnnouncements Boolean @default(true)
  resultsVisibility String @default("turnout-only") // hidden | turnout-only | partial | public
  customWelcomeText String?
  customFooterText  String?
  socialLinks     String?  // JSON: { twitter, facebook, instagram, linkedin, website }
  metaDescription String?  // SEO meta description
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

/// A homepage block — customizable content blocks on the org portal.
model HomepageBlock {
  id              String   @id @default(cuid())
  organizationId  String
  blockType       String   // HERO | STATS | COUNTDOWN | ELECTIONS | CANDIDATES | ANNOUNCEMENTS | COMMITTEE | CUSTOM
  title           String?
  content         String?  // markdown or HTML
  position        Int      @default(0) // display order
  visible         Boolean  @default(true)
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([blockType])
  @@index([position])
}

/// A homepage banner — promotional or informational banners.
model HomepageBanner {
  id              String   @id @default(cuid())
  organizationId  String
  title           String
  message         String
  type            String   @default("INFO") // INFO | WARNING | SUCCESS | URGENT
  imageUrl        String?
  actionUrl       String?
  actionLabel     String?
  dismissible     Boolean  @default(true)
  startDate       DateTime?
  endDate         DateTime?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@index([active])
}

// ---------------------------------------------------------------------------
// DOMAIN: UNIVERSITY HIERARCHY EXPANSION (High)
// Spec: "University → Campus → Faculty → Department → Programme → Level → Class"
// ---------------------------------------------------------------------------

/// A campus — many universities have multiple campuses.
model Campus {
  id              String   @id @default(cuid())
  organizationId  String
  name            String   // "Main Campus", "College of Medicine Campus"
  code            String?
  address         String?
  city            String?
  state           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

/// A class — the finest level of the hierarchy (e.g., "300 Level Civil
/// Engineering 2024/2025 Session").
model ClassRoom {
  id              String   @id @default(cuid())
  organizationId  String
  campusId        String?
  facultyId       String?
  departmentId    String?
  programmeId     String?
  name            String   // "300 Level 2024/2025"
  level           String?  // "100" | "200" | "300" | "400" | "500"
  session         String?  // "2024/2025"
  studentCount    Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@index([departmentId])
}

// ---------------------------------------------------------------------------
// DOMAIN: ELECTION GROUP (High — Multi-Election Support)
// Spec: "University → Election Group → Student Union, Faculty Elections,
// Department Elections, Hostel Elections, Club Elections. Each group owns
// positions, candidates, observers, results. Independent."
// ---------------------------------------------------------------------------

/// An election group — groups related elections under one umbrella. E.g.,
/// "2025 SUG Elections" contains the Student Union election + all faculty
/// elections + all department elections.
model ElectionGroup {
  id              String   @id @default(cuid())
  organizationId  String
  name            String   // "2025 SUG Elections"
  description     String?
  type            String   // STUDENT_UNION | FACULTY | DEPARTMENT | HOSTEL | CLUB | MIXED
  status          String   @default("DRAFT") // DRAFT | ACTIVE | COMPLETED | ARCHIVED
  electionIds     String?  // JSON array of election session IDs
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// DOMAIN: SUPPORT EXPANSION (High)
// Spec: "SupportAttachment, SupportEscalation, SupportBotLog"
// ---------------------------------------------------------------------------

/// An attachment on a support message — screenshots, PDFs, images.
/// Spec: "All files are scanned before storage."
model SupportAttachment {
  id              String   @id @default(cuid())
  conversationId  String
  messageId       String?
  fileName        String
  fileType        String   // IMAGE | PDF | DOCUMENT | SCREENSHOT | OTHER
  fileSizeBytes   Int
  storageKey      String   // S3 key or local path
  mimeType        String?
  scannedForMalware Boolean @default(false)
  scanResult      String?  // CLEAN | INFECTED | ERROR
  uploadedBy      String
  uploadedAt      DateTime @default(now())

  @@index([conversationId])
  @@index([fileType])
}

/// An escalation record — tracks every escalation step with reason + timestamp.
model SupportEscalation {
  id              String   @id @default(cuid())
  conversationId  String
  fromLevel       Int      // 0=org admin, 1=observer, 2=votewise support, 3=platform admin
  toLevel         Int
  reason          String
  escalatedBy     String
  escalatedByName String
  createdAt       DateTime @default(now())

  @@index([conversationId])
}

/// A chatbot interaction log — records what the bot said + whether it helped.
/// Spec: "Before a human joins, an AI-powered chatbot handles common requests."
model SupportBotLog {
  id              String   @id @default(cuid())
  conversationId  String
  voterQuery      String
  botResponse     String
  intent          String?  // HOW_TO_VOTE | OTP_NOT_RECEIVED | ELIGIBILITY | VOTING_CLOSE | RECEIPT_VERIFY | CANDIDATES | OTHER
  confidence      Float    @default(0)
  resolved        Boolean  @default(false) // did the bot resolve it?
  escalatedToHuman Boolean @default(false)
  feedbackRating  Int?     // 1-5 (voter rates the bot)
  createdAt       DateTime @default(now())

  @@index([conversationId])
  @@index([intent])
}

// ---------------------------------------------------------------------------
// DOMAIN: REPORT GENERATION (High)
// Spec: "Report, GeneratedReport, ScheduledReport, ReportDownload"
// ---------------------------------------------------------------------------

/// A report definition — what the report contains + who can access it.
model ReportDefinition {
  id              String   @id @default(cuid())
  organizationId  String?
  name            String   // "Election Summary Report"
  type            String   // ELECTION_SUMMARY | TURNOUT | CERTIFICATION | AUDIT_TRAIL | OBSERVER | INTEGRITY | FINANCIAL | ANALYTICS
  description     String?
  format          String   @default("PDF") // PDF | CSV | JSON | XLSX
  template        String?  // report template identifier
  accessLevel     String   @default("ORG_ADMIN") // who can generate it
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([type])
}

/// A generated report instance — the actual file + metadata.
model GeneratedReport {
  id              String   @id @default(cuid())
  organizationId  String?
  electionId      String?
  definitionId    String?
  reportName      String
  reportType      String
  format          String
  storageKey      String   // S3 key or local path
  fileSizeBytes   Int      @default(0)
  generatedBy     String?
  generatedByName String?
  parameters      String?  // JSON: the params used to generate
  status          String   @default("COMPLETED") // PENDING | GENERATING | COMPLETED | FAILED
  error           String?
  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@index([electionId])
  @@index([reportType])
}

/// A scheduled report — recurring report generation (e.g., weekly turnout).
model ScheduledReport {
  id              String   @id @default(cuid())
  organizationId  String?
  electionId      String?
  definitionId    String?
  cronExpression  String   // e.g., "0 9 * * 1" = every Monday 9am
  recipients      String   // JSON array of email addresses
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@index([enabled])
}

/// A report download record — tracks who downloaded what + when.
model ReportDownload {
  id              String   @id @default(cuid())
  reportId        String
  downloadedBy    String
  downloadedByName String?
  ipAddress       String?
  createdAt       DateTime @default(now())

  @@index([reportId])
}

// ---------------------------------------------------------------------------
// DOMAIN: AI CHATBOT (Medium)
// Spec: "BotConversation, BotKnowledge, BotFeedback, BotEscalation"
// ---------------------------------------------------------------------------

/// A bot conversation — a dedicated conversation between a voter and the AI
/// chatbot (distinct from SupportConversation which is human-staffed).
model BotConversation {
  id              String   @id @default(cuid())
  organizationId  String
  electionId      String?
  voterId         String?
  voterIdentifier String?
  status          String   @default("ACTIVE") // ACTIVE | ESCALATED | RESOLVED | ABANDONED
  messageCount    Int      @default(0)
  resolvedByBot   Boolean  @default(false)
  escalatedToHuman Boolean @default(false)
  supportConversationId String? // link to SupportConversation if escalated
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
}

/// Bot knowledge base entries — FAQ items the bot uses to answer questions.
model BotKnowledge {
  id              String   @id @default(cuid())
  organizationId  String?
  question        String
  answer          String
  category        String   // VOTING | OTP | ELIGIBILITY | RESULTS | RECEIPT | CANDIDATES | TIMETETABLE | SUPPORT
  keywords        String?  // JSON array of keywords for matching
  enabled         Boolean  @default(true)
  hitCount        Int      @default(0)
  helpfulCount    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([category])
  @@index([enabled])
}

/// Voter feedback on the bot — helps improve bot quality.
model BotFeedback {
  id              String   @id @default(cuid())
  conversationId  String
  messageId       String?
  rating          Int      // 1-5
  comment         String?
  createdAt       DateTime @default(now())

  @@index([conversationId])
}

/// A bot escalation — when the bot can't resolve and escalates to human.
model BotEscalation {
  id              String   @id @default(cuid())
  conversationId  String
  reason          String   // UNRESOLVED | COMPLEX | VOTER_REQUESTED | LOW_CONFIDENCE
  botMessage      String?
  supportConversationId String?
  createdAt       DateTime @default(now())

  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// DOMAIN: HEALTH MONITORING (Medium)
// Spec: "ServiceHealth, WorkerHealth, QueueHealth, ProviderHealth"
// ---------------------------------------------------------------------------

/// Service health snapshot — periodic health check for each service.
model ServiceHealth {
  id              String   @id @default(cuid())
  service         String   // API | DATABASE | REDIS | WEBSOCKET | WORKER | SCHEDULER | NOTIFICATION | FRAUD_ENGINE | ANALYTICS_ENGINE
  status          String   // HEALTHY | DEGRADED | UNHEALTHY
  latencyMs       Int      @default(0)
  uptimePct       Float    @default(100)
  details         String?  // JSON: { cpu, memory, connections, ... }
  checkedAt       DateTime @default(now())

  @@index([service])
  @@index([checkedAt])
}

/// Worker health — tracks the background worker process.
model WorkerHealth {
  id              String   @id @default(cuid())
  workerName      String   // email-worker | sms-worker | report-worker | fraud-worker
  status          String   // IDLE | PROCESSING | OVERLOADED | STOPPED
  jobsProcessed   Int      @default(0)
  jobsFailed      Int      @default(0)
  avgJobDurationMs Int     @default(0)
  queueDepth      Int      @default(0)
  lastHeartbeat   DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([workerName])
  @@index([status])
}

/// Queue health — tracks the job queue depth + processing rate.
model QueueHealth {
  id              String   @id @default(cuid())
  queueName       String   // email | sms | whatsapp | report | analytics | backup
  depth           Int      @default(0)
  processingRate  Float    @default(0) // jobs per second
  avgWaitTimeMs   Int      @default(0)
  oldestJobAge    Int      @default(0) // seconds
  checkedAt       DateTime @default(now())

  @@index([queueName])
  @@index([checkedAt])
}

// ---------------------------------------------------------------------------
// DOMAIN: VOTER EXPANSION (Medium)
// Spec: "VoterIdentity, VoterEligibility, VoterVerification"
// ---------------------------------------------------------------------------

/// Voter identity — separated from the Voter core record for privacy + GDPR.
/// Stores PII separately so it can be anonymized without losing the vote record.
model VoterIdentity {
  id              String   @id @default(cuid())
  voterId         String   @unique
  organizationId  String
  fullName        String
  email           String?
  phone           String?
  whatsapp        String?
  matricNumber    String?
  photoUrl        String?
  dateOfBirth     DateTime?
  gender          String?
  nationality     String?
  stateOfOrigin   String?
  lga             String?
  anonymized      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([matricNumber])
}

/// Voter eligibility — the rules that determine if a voter can vote in a
/// specific election. Separated for flexibility.
model VoterEligibility {
  id              String   @id @default(cuid())
  voterId         String
  electionId      String
  organizationId  String
  eligible        Boolean  @default(true)
  reason          String?  // why ineligible (if applicable)
  facultyId       String?
  departmentId    String?
  programmeId     String?
  level           String?
  classId         String?
  verifiedAt      DateTime?
  verifiedBy      String?
  createdAt       DateTime @default(now())

  @@unique([voterId, electionId])
  @@index([electionId])
  @@index([organizationId])
}

/// Voter verification — tracks identity verification attempts (matric check,
/// OTP, biometric, etc.).
model VoterVerification {
  id              String   @id @default(cuid())
  voterId         String
  organizationId  String
  electionId      String?
  method          String   // MATRIC | OTP | EMAIL | PHONE | BIOMETRIC | ADMIN_OVERRIDE
  status          String   @default("PENDING") // PENDING | VERIFIED | FAILED | EXPIRED
  attempts        Int      @default(0)
  verifiedAt      DateTime?
  verifiedBy      String?
  ipAddress       String?
  deviceFingerprint String?
  metadata        String?  // JSON
  createdAt       DateTime @default(now())

  @@index([voterId])
  @@index([electionId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// DOMAIN: RECEIPT EXPANSION (Medium)
// Spec: "VoteReceipt, ReceiptVerification, ReceiptAudit. A receipt should
// always prove vote exists, never reveal choice."
// ---------------------------------------------------------------------------

/// A receipt verification log — every time someone verifies a receipt.
model ReceiptVerification {
  id              String   @id @default(cuid())
  receiptCode     String
  verifiedBy      String?  // null = anonymous public verification
  ipAddress       String?
  userAgent       String?
  valid           Boolean
  verifiedAt      DateTime @default(now())

  @@index([receiptCode])
  @@index([verifiedAt])
}

/// A receipt audit — internal audit trail for receipt-related actions
/// (generation, verification, revocation).
model ReceiptAudit {
  id              String   @id @default(cuid())
  receiptCode     String
  action          String   // GENERATED | VERIFIED | REVOKED | REGENERATED
  actorId         String?
  actorName       String?
  ipAddress       String?
  details         String?  // JSON
  createdAt       DateTime @default(now())

  @@index([receiptCode])
  @@index([action])
}

// ---------------------------------------------------------------------------
// DOMAIN: ANALYTICS EXPANSION (Medium)
// Spec: "ElectionAnalytics, VotingAnalytics, TurnoutAnalytics, RealtimeMetrics"
// ---------------------------------------------------------------------------

/// Election analytics snapshot — periodic aggregate metrics for an election.
model ElectionAnalytics {
  id              String   @id @default(cuid())
  organizationId  String
  electionId      String
  totalEligible   Int      @default(0)
  totalVerified   Int      @default(0)
  totalVotes      Int      @default(0)
  turnoutPct      Float    @default(0)
  invalidVotes    Int      @default(0)
  blankVotes      Int      @default(0)
  rejectedOtps    Int      @default(0)
  avgVoteTimeMs   Int      @default(0)
  peakConcurrentVoters Int @default(0)
  capturedAt      DateTime @default(now())

  @@index([electionId])
  @@index([capturedAt])
}

/// Turnout analytics — turnout broken down by faculty/department/level.
model TurnoutAnalytics {
  id              String   @id @default(cuid())
  organizationId  String
  electionId      String
  breakdown       String   // FACULTY | DEPARTMENT | PROGRAMME | LEVEL | CLASS | GENDER | GEOGRAPHIC
  breakdownKey    String   // the faculty/department/level identifier
  breakdownLabel  String   // human-readable label
  eligible        Int      @default(0)
  voted           Int      @default(0)
  turnoutPct      Float    @default(0)
  capturedAt      DateTime @default(now())

  @@index([electionId])
  @@index([breakdown])
  @@index([capturedAt])
}

/// Realtime activity — live voter activity feed for the Election Operations
/// Console. Spec: "RealtimeActivity → Login → Verification → OTVP → Vote
/// Started → Vote Completed."
model RealtimeActivity {
  id              String   @id @default(cuid())
  organizationId  String
  electionId      String?
  voterId         String?
  activityType    String   // LOGIN | VERIFY_MATRIC | OTP_SENT | OTP_VERIFIED | VOTING_STARTED | VOTE_RECORDED | SESSION_EXPIRED | SUPPORT_REQUEST
  ipAddress       String?
  deviceFingerprint String?
  metadata        String?  // JSON
  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@index([electionId])
  @@index([activityType])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// DOMAIN: ORGANIZATION SPLITTING (Medium)
// Spec: "OrganizationSettings, OrganizationSecurity, OrganizationBilling"
// ---------------------------------------------------------------------------

/// Organization security settings — 2FA policy, IP allowlist, session config.
model OrganizationSecurity {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  requireMfa      Boolean  @default(false)
  mfaRoles        String?  // JSON array of roles that require MFA
  ipAllowlist     String?  // JSON array of allowed CIDR ranges
  sessionTimeoutMin Int    @default(15)
  maxLoginAttempts Int     @default(5)
  lockoutDurationMin Int   @default(30)
  passwordPolicy  String?  // JSON: { minLength, requireUppercase, ... }
  auditLogRetentionDays Int @default(365)
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

/// Organization billing profile — billing address, tax info, payment methods.
model OrganizationBilling {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  billingEmail    String?
  billingName     String?
  billingAddress  String?
  billingCity     String?
  billingState    String?
  billingCountry  String   @default("Nigeria")
  billingPostalCode String?
  taxId           String?  // TIN / VAT number
  taxExempt       Boolean  @default(false)
  paymentMethodId String?  // default payment method
  currency        String   @default("NGN")
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

/// A registered WebAuthn/FIDO2 security key (hardware key or passkey).
/// Spec: "Hardware security key support" for Platform Authentication.
/// Users can register one or more security keys for passwordless or
/// second-factor authentication.
model SecurityKey {
  id              String   @id @default(cuid())
  officialId      String   // ElectionOfficial ID
  credentialId    String   @unique // base64url encoded credential ID
  publicKey       String   // base64url encoded public key
  counter         Int      @default(0) // signature counter for replay detection
  transports      String?  // JSON array: ["usb", "nfc", "ble", "internal"]
  name            String?  // user-friendly name: "YubiKey 5C" or "iPhone Passkey"
  platform       String?  // "cross-platform" (hardware key) or "platform" (passkey)
  lastUsedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([officialId])
}

/// Platform-level credential — stores encrypted API keys for providers
/// (Resend, Termii, Paystack, Flutterwave, Stripe, Sentry, S3, Slack, etc.)
/// These are managed through the admin UI and synced to process.env at
/// runtime so all code that reads process.env works seamlessly.
model PlatformCredential {
  id              String   @id @default(cuid())
  key             String   @unique // e.g. RESEND_API_KEY, TERMII_API_KEY
  displayName     String   // "Resend API Key"
  category        String   // EMAIL | SMS | WHATSAPP | PAYMENT | MONITORING | STORAGE | NOTIFICATION | DATABASE | CACHE
  provider        String   // resend | termii | paystack | flutterwave | stripe | sentry | s3 | slack | teams
  encryptedValue  String   // AES-256-GCM encrypted value
  iv              String   // initialization vector
  keyId           String   @default("v1") // which encryption key was used
  description     String?  // what this key is for
  maskedValue     String   // masked preview: re_****...****abc
  isConfigured    Boolean  @default(false)
  isRequired      Boolean  @default(false) // required for platform to function
  lastRotatedAt   DateTime?
  lastVerifiedAt  DateTime?
  lastVerifiedStatus String? // VALID | INVALID | UNTESTED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category])
  @@index([provider])
  @@index([isConfigured])
}
